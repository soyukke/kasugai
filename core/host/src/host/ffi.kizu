    if socket_path |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if owned_sock.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return 0;
        }
    }
    var owned_bin = string::new(allocator);
    defer owned_bin.deinit(allocator);
    if ctl_bin |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if owned_bin.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return 0;
        }
    }
    let sock_bytes = owned_sock.as_bytes();
    let bin_bytes = owned_bin.as_bytes();
    let core = unsafe &var live.*;
    if core.set_orchestrator_bridge(allocator, sock_bytes, bin_bytes) {
        return 1;
    } else |_| {}
    return 0;
}

export "c" fn kasugai_core_bind_worktree(
    handle: ?ptr<engine::Core>,
    thread_id: i64,
    branch: ?ptr<const u8>,
    base_ref: ?ptr<const u8>,
    worktree_path: ?ptr<const u8>
) -> u8 {
    let live = handle orelse return 0;
    let raw_branch = branch orelse return 0;
    let raw_path = worktree_path orelse return 0;
    let allocator = mem::page_allocator();
    if c_string(allocator, raw_branch) |owned_branch| {
        defer owned_branch.deinit(allocator);
        if c_string(allocator, raw_path) |owned_path| {
            defer owned_path.deinit(allocator);
            var owned_base = string::new(allocator);
            defer owned_base.deinit(allocator);
            if base_ref |raw_base| {
                if c_string(allocator, raw_base) |copied| {
                    let bytes = copied.as_bytes();
                    if owned_base.append_bytes(allocator, bytes) {} else |_| {}
                    copied.deinit(allocator);
                } else |_| {
                    return 0;
                }
            }
            let branch_bytes = owned_branch.as_bytes();
            let base_bytes = owned_base.as_bytes();
            let path_bytes = owned_path.as_bytes();
            let core = unsafe &var live.*;
            if core.bind_worktree(allocator, thread_id, branch_bytes, base_bytes, path_bytes) |ok| {
                return flag(ok);
            } else |_| {}
        } else |_| {}
    } else |_| {}
    return 0;
}

export "c" fn kasugai_core_reset_worktree(handle: ?ptr<engine::Core>, thread_id: i64) -> u8 {
    let live = handle orelse return 0;
    let core = unsafe &var live.*;
