import kasugai::engine;
import kasugai::provider;
import std::mem;
import std::string;

export "c" fn kasugai_core_create_with_store(
    default_project_name: ?ptr<const u8>,
    default_project_path: ?ptr<const u8>,
    store_path: ?ptr<const u8>
) -> ?ptr<engine::Core> {
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    defer name.deinit(allocator);
    if default_project_name |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if name.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return null;
        }
    }
    var path = string::new(allocator);
    defer path.deinit(allocator);
    if default_project_path |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if path.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return null;
        }
    }
    var store = string::new(allocator);
    defer store.deinit(allocator);
    if store_path |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if store.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return null;
        }
    }
    let name_bytes = name.as_bytes();
    let path_bytes = path.as_bytes();
    let store_bytes = store.as_bytes();
    if engine::new_core_with_store(allocator, name_bytes, path_bytes, store_bytes) |value| {
        let storage = unsafe malloc(mem::size_of<engine::Core>());
        if storage |slot| {
            let handle = unsafe cast<ptr<engine::Core>>(slot);
            unsafe ptr_write(handle, move value);
            return handle;
        }
        value.deinit(allocator);
    } else |_| {}
    return null;
}

export "c" fn kasugai_core_create(
    default_project_name: ?ptr<const u8>,
    default_project_path: ?ptr<const u8>
) -> ?ptr<engine::Core> {
    return kasugai_core_create_with_store(default_project_name, default_project_path, null);
}

export "c" fn kasugai_core_destroy(handle: ?ptr<engine::Core>) -> void {
    if handle |live| {
        let value = unsafe ptr_read(live);
        value.deinit(mem::page_allocator());
        unsafe free(cast<ptr<u8>>(live));
    }
    return;
}

export "c" fn kasugai_core_add_project(
    handle: ?ptr<engine::Core>,
    name: ?ptr<const u8>,
    root_path: ?ptr<const u8>
) -> i64 {
    let live = handle orelse return -1;
    let raw_name = name orelse return -1;
    let raw_path = root_path orelse return -1;
    let allocator = mem::page_allocator();
    if c_string(allocator, raw_name) |owned_name| {
        defer owned_name.deinit(allocator);
        if c_string(allocator, raw_path) |owned_path| {
            defer owned_path.deinit(allocator);
            let name_bytes = owned_name.as_bytes();
            let path_bytes = owned_path.as_bytes();
            let core = unsafe &var live.*;
            if core.add_project(allocator, name_bytes, path_bytes) |project_id| {
                return project_id;
            } else |_| {}
        } else |_| {}
    } else |_| {}
    return -1;
}

export "c" fn kasugai_core_select_project(handle: ?ptr<engine::Core>, project_id: i64) -> u8 {
    let live = handle orelse return 0;
    let core = unsafe &var live.*;
    return flag(core.select_project(project_id));
}

export "c" fn kasugai_core_create_thread(
    handle: ?ptr<engine::Core>,
    project_id: i64,
    title: ?ptr<const u8>,
    provider_name: ?ptr<const u8>,
    model_name: ?ptr<const u8>,
    effort_name: ?ptr<const u8>
) -> i64 {
    let live = handle orelse return -1;
    let allocator = mem::page_allocator();
    var owned_title = string::new(allocator);
    defer owned_title.deinit(allocator);
    if title |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if owned_title.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return -1;
        }
    }
    var kind = provider::ProviderKind::LocalEcho;
    if provider_name |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            let ok = provider::parse_provider(bytes, &var kind);
            copied.deinit(allocator);
            if !ok {
                return -1;
            }
        } else |_| {
            return -1;
        }
    }
    var owned_model = string::new(allocator);
    defer owned_model.deinit(allocator);
    if model_name |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if owned_model.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return -1;
        }
    }
    var effort = provider::ReasoningEffort::Medium;
    if effort_name |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            let ok = provider::parse_effort(bytes, &var effort);
            copied.deinit(allocator);
            if !ok {
                return -1;
            }
        } else |_| {
            return -1;
        }
    }
    let title_bytes = owned_title.as_bytes();
    let model_bytes = owned_model.as_bytes();
    let core = unsafe &var live.*;
    if core.create_thread(allocator, project_id, title_bytes, kind, model_bytes, effort) |thread_id| {
        return thread_id;
    } else |_| {}
    return -1;
}

export "c" fn kasugai_core_select_thread(handle: ?ptr<engine::Core>, thread_id: i64) -> u8 {
    let live = handle orelse return 0;
    let core = unsafe &var live.*;
    return flag(core.select_thread(thread_id));
}

export "c" fn kasugai_core_rename_thread(
    handle: ?ptr<engine::Core>,
    thread_id: i64,
    title: ?ptr<const u8>
) -> u8 {
    let live = handle orelse return 0;
    let raw = title orelse return 0;
    let allocator = mem::page_allocator();
    if c_string(allocator, raw) |owned| {
        defer owned.deinit(allocator);
        let bytes = owned.as_bytes();
        let core = unsafe &var live.*;
        if core.rename_thread(allocator, thread_id, bytes) |done| {
            return flag(done);
        } else |_| {}
    } else |_| {}
    return 0;
}

export "c" fn kasugai_core_set_thread_provider(
    handle: ?ptr<engine::Core>,
    thread_id: i64,
