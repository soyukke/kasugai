    model_name: ?ptr<const u8>,
    effort_name: ?ptr<const u8>
) -> u8 {
    let live = handle orelse return 0;
    let raw_provider = provider_name orelse return 0;
    let raw_effort = effort_name orelse return 0;
    let allocator = mem::page_allocator();
    var kind = provider::ProviderKind::LocalEcho;
    if c_string(allocator, raw_provider) |copied| {
        let bytes = copied.as_bytes();
        let ok = provider::parse_provider(bytes, &var kind);
        copied.deinit(allocator);
        if !ok {
            return 0;
        }
    } else |_| {
        return 0;
    }
    var effort = provider::ReasoningEffort::Medium;
    if c_string(allocator, raw_effort) |copied| {
        let bytes = copied.as_bytes();
        let ok = provider::parse_effort(bytes, &var effort);
        copied.deinit(allocator);
        if !ok {
            return 0;
        }
    } else |_| {
        return 0;
    }
    var owned_model = string::new(allocator);
    defer owned_model.deinit(allocator);
    if model_name |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if owned_model.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return 0;
        }
    }
    let model_bytes = owned_model.as_bytes();
    let core = unsafe &var live.*;
    if core.set_thread_provider(allocator, thread_id, kind, model_bytes, effort) |done| {
        return flag(done);
    } else |_| {}
    return 0;
}

export "c" fn kasugai_core_send_message(
    handle: ?ptr<engine::Core>,
    thread_id: i64,
    text: ?ptr<const u8>,
    attachments_nl: ?ptr<const u8>
) -> i64 {
    let live = handle orelse return -1;
    let raw_text = text orelse return -1;
    let allocator = mem::page_allocator();
    if c_string(allocator, raw_text) |owned_text| {
        defer owned_text.deinit(allocator);
        var owned_attachments = string::new(allocator);
        defer owned_attachments.deinit(allocator);
        if attachments_nl |raw_att| {
            if c_string(allocator, raw_att) |copied| {
                let bytes = copied.as_bytes();
                if owned_attachments.append_bytes(allocator, bytes) {} else |_| {}
                copied.deinit(allocator);
            } else |_| {
                return -1;
            }
        }
        let text_bytes = owned_text.as_bytes();
        let att_bytes = owned_attachments.as_bytes();
        let core = unsafe &var live.*;
        if core.send_message(allocator, thread_id, text_bytes, att_bytes) |turn_id| {
            return turn_id;
        } else |_| {}
    } else |_| {}
    return -1;
}

