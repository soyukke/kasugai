export "c" fn kasugai_core_set_provider_command_override(
    handle: ?ptr<engine::Core>,
    provider_name: ?ptr<const u8>,
    executable: ?ptr<const u8>,
    args_nl: ?ptr<const u8>
) -> u8 {
    let live = handle orelse return 0;
    let raw_provider = provider_name orelse return 0;
    let allocator = mem::page_allocator();
    var kind = provider::ProviderKind::LocalEcho;
    if c_string(allocator, raw_provider) |copied| {
        let bytes = copied.as_bytes();
        let ok = provider::parse_provider(bytes, &var kind);
        copied.deinit(allocator);
        if !ok {
            return 0;
        }
    } else |_| {
        return 0;
    }
    var owned_exec = string::new(allocator);
    defer owned_exec.deinit(allocator);
    if executable |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if owned_exec.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return 0;
        }
    }
    var owned_args = string::new(allocator);
    defer owned_args.deinit(allocator);
    if args_nl |raw| {
        if c_string(allocator, raw) |copied| {
            let bytes = copied.as_bytes();
            if owned_args.append_bytes(allocator, bytes) {} else |_| {}
            copied.deinit(allocator);
        } else |_| {
            return 0;
        }
    }
    let exec_bytes = owned_exec.as_bytes();
    let args_bytes = owned_args.as_bytes();
    let core = unsafe &var live.*;
    if core.set_provider_command_override(allocator, kind, exec_bytes, args_bytes) {
        return 1;
    } else |_| {}
    return 0;
}

