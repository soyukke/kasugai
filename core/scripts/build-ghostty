#!/usr/bin/env bash
set -euo pipefail

unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE

repo="https://github.com/ghostty-org/ghostty.git"
commit="a887df42c56f6de86c0fe6da9c4eeca37931e083"
optimize="${1:-ReleaseSmall}"
root="$(cd "$(dirname "$0")/.." && pwd)"
source_dir="$root/target/ghostty/source"
prefix="$root/target/ghostty/install"
target_lib="$root/target/native/libghostty-vt.a"
stamp_file="$root/target/native/ghostty.commit"

if [[ -f "$target_lib" && -f "$stamp_file" ]] && [[ "$(cat "$stamp_file")" == "$commit:$optimize" ]]; then
  exit 0
fi

if [[ -z "${KUGI_ACTIVE:-}" ]] && ! command -v zig >/dev/null 2>&1; then
  exec kugi exec -- env KUGI_ACTIVE=1 "$0" "$@"
fi

if [[ "$(git -C "$source_dir" rev-parse HEAD 2>/dev/null || true)" != "$commit" ]]; then
  rm -rf "$source_dir"
  mkdir -p "$source_dir"
  git -C "$source_dir" init -q
  git -C "$source_dir" fetch -q --depth 1 "$repo" "$commit"
  git -C "$source_dir" checkout -q FETCH_HEAD
fi

(
  cd "$source_dir"
  zig build \
    -Demit-lib-vt=true \
    "-Doptimize=$optimize" \
    -Demit-xcframework=false \
    -Dapp-runtime=none \
    --prefix "$prefix" \
    --cache-dir "$root/target/ghostty/zig-cache"
)

archive="$prefix/lib/libghostty-vt.a"
if [[ ! -f "$archive" ]]; then
  echo "build-ghostty: zig build left no $archive" >&2
  exit 1
fi

mkdir -p "$root/target/native"
merged="$root/target/native/libghostty-vt.o"
/usr/bin/ld -r -arch "$(uname -m)" -platform_version macos 14.0 14.0 -all_load "$archive" -o "$merged"
rm -f "$target_lib"
ar -rc "$target_lib" "$merged"
ranlib "$target_lib"
rm -f "$merged"
printf '%s\n' "$commit:$optimize" >"$stamp_file"
echo "target/native/libghostty-vt.a <- $archive"
