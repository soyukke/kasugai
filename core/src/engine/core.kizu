import kasugai::event;
import kasugai::provider;
import kasugai::store;
import kasugai::workspace;
import std::array;
import std::fmt;
import std::json;
import std::mem;
import std::string;

pub enum MessageRole {
    User,
    Assistant,
    System,
}

pub fn role_name(role: MessageRole) -> []u8 {
    if role == MessageRole::User {
        return "user";
    }
    if role == MessageRole::Assistant {
        return "assistant";
    }
    return "system";
}

pub struct Message {
    pub id: i64,
    pub turn_id: i64,
    pub role: MessageRole,
    pub text: string::String,
    pub attachments: array::Array<string::String>,
    pub provider: string::String,
    pub model: string::String,
}

pub fn (self: Message) deinit(allocator: Allocator) -> void {
    self.text.deinit(allocator);
    self.attachments.deinit(allocator);
    self.provider.deinit(allocator);
    self.model.deinit(allocator);
}

pub struct QueuedTurn {
    pub turn_id: i64,
    pub text: string::String,
    pub attachments: array::Array<string::String>,
}

pub fn (self: QueuedTurn) deinit(allocator: Allocator) -> void {
    self.text.deinit(allocator);
    self.attachments.deinit(allocator);
}

pub struct PendingApproval {
    pub active: bool,
    pub tool_name: string::String,
    pub summary: string::String,
}

pub fn (self: PendingApproval) deinit(allocator: Allocator) -> void {
    self.tool_name.deinit(allocator);
    self.summary.deinit(allocator);
}

pub struct ThreadActivity {
    pub turn_id: i64,
    pub call_id: string::String,
    pub kind: string::String,
    pub title: string::String,
    pub status: string::String,
    pub detail: string::String,
}

pub fn (self: ThreadActivity) deinit(allocator: Allocator) -> void {
    self.call_id.deinit(allocator);
    self.kind.deinit(allocator);
    self.title.deinit(allocator);
    self.status.deinit(allocator);
    self.detail.deinit(allocator);
}

pub struct Thread {
    pub id: i64,
    pub project_id: i64,
    pub title: string::String,
    pub updated_at_ms: i64,
    pub machine_state: TurnMachineState,
    pub provider: provider::ProviderKind,
    pub model: string::String,
    pub effort: provider::ReasoningEffort,
    pub active_turn_id: i64,
    pub streaming_text: string::String,
    pub last_error: string::String,
    pub provider_session_id: string::String,
    pub available_models: array::Array<string::String>,
    pub activities: array::Array<ThreadActivity>,
    pub pending_approval: PendingApproval,
    pub workspace: workspace::WorkspaceBinding,
    pub messages: array::Array<Message>,
    pub queue: array::Array<QueuedTurn>,
}

pub fn (self: Thread) deinit(allocator: Allocator) -> void {
    self.title.deinit(allocator);
    self.model.deinit(allocator);
    self.streaming_text.deinit(allocator);
    self.last_error.deinit(allocator);
    self.provider_session_id.deinit(allocator);
    self.available_models.deinit(allocator);
    self.activities.deinit(allocator);
    self.pending_approval.deinit(allocator);
    self.workspace.deinit(allocator);
    self.messages.deinit(allocator);
    self.queue.deinit(allocator);
}

pub struct Project {
    pub id: i64,
    pub name: string::String,
    pub root_path: string::String,
}

pub fn (self: Project) deinit(allocator: Allocator) -> void {
    self.name.deinit(allocator);
    self.root_path.deinit(allocator);
}

pub struct Core {
    pub projects: array::Array<Project>,
    pub threads: array::Array<Thread>,
    pub sessions: array::Array<provider::ProviderSession>,
    pub command_overrides: array::Array<provider::CommandOverride>,
    pub bridge_socket: string::String,
    pub bridge_bin: string::String,
    pub active_project_id: i64,
    pub active_thread_id: i64,
    pub next_project_id: i64,
    pub next_thread_id: i64,
    pub next_message_id: i64,
    pub next_turn_id: i64,
    pub suppress_telemetry: bool,
    pub auto_approve_tools: bool,
    pub store: store::EventStore,
}

pub fn (self: Core) deinit(allocator: Allocator) -> void {
    self.sessions.deinit(allocator);
    self.command_overrides.deinit(allocator);
    self.bridge_socket.deinit(allocator);
    self.bridge_bin.deinit(allocator);
    self.projects.deinit(allocator);
    self.threads.deinit(allocator);
    self.store.deinit(allocator);
}

fn is_blank(bytes: []u8) -> bool {
    var index = 0;
    while index < mem::len(bytes) {
        let byte = bytes[index];
        if byte != cast<u8>(32) and byte != cast<u8>(9) and byte != cast<u8>(10) and
            byte != cast<u8>(13) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn parse_attachments(allocator: Allocator, raw: []u8) -> mem::Error!array::Array<string::String> {
    var list = array::new<string::String>(allocator);
    errdefer list.deinit(allocator);
    var start: i64 = 0;
    let total = mem::len(raw);
    while start < total {
        var end = start;
        while end < total and raw[end] != cast<u8>(10) {
            end = end + 1;
        }
        var line_end = end;
        if line_end > start and raw[line_end - 1] == cast<u8>(13) {
            line_end = line_end - 1;
        }
        if line_end > start {
            let segment = raw[start..line_end];
            if !is_blank(segment) {
                var entry = try string::from_bytes(allocator, segment);
                errdefer entry.deinit(allocator);
                string::trim_space_in_place(&var entry);
                if entry.len() > 0 {
                    try list.append(allocator, move entry);
                } else {
                    entry.deinit(allocator);
                }
            }
        }
        start = end + 1;
    }
    return move list;
}

fn replace_string_array(
    allocator: Allocator,
    dst: &var array::Array<string::String>,
    src: &array::Array<string::String>
) -> mem::Error!void {
    dst.clear(allocator);
    var index = 0;
    while src.at(index) |item| {
        let bytes = item.as_bytes();
        var copy = try string::from_bytes(allocator, bytes);
        errdefer copy.deinit(allocator);
        try dst.append(allocator, move copy);
        index = index + 1;
    }
    return;
}

fn clone_string_array(
    allocator: Allocator,
    items: &array::Array<string::String>
) -> mem::Error!array::Array<string::String> {
    var out = array::new<string::String>(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while items.at(index) |item| {
        let bytes = item.as_bytes();
        let copy = try string::from_bytes(allocator, bytes);
        try out.append(allocator, move copy);
        index = index + 1;
    }
    return move out;
}

fn join_attachments(
    allocator: Allocator,
    items: &array::Array<string::String>,
    out: &var string::String
) -> mem::Error!void {
    var index = 0;
    while items.at(index) |item| {
        if index > 0 {
            try out.append_byte(allocator, 10);
        }
        let bytes = item.as_bytes();
        try out.append_bytes(allocator, bytes);
        index = index + 1;
    }
    return;
}

fn build_empty_core(allocator: Allocator) -> Core {
    return Core {
        projects: array::new<Project>(allocator),
        threads: array::new<Thread>(allocator),
        sessions: array::new<provider::ProviderSession>(allocator),
        command_overrides: array::new<provider::CommandOverride>(allocator),
        bridge_socket: string::new(allocator),
        bridge_bin: string::new(allocator),
        active_project_id: 0,
        active_thread_id: 0,
        next_project_id: 1,
        next_thread_id: 1,
        next_message_id: 1,
        next_turn_id: 1,
        suppress_telemetry: true,
        auto_approve_tools: false,
        store: store::new_memory_store(allocator)
    };
}

fn (self: &Core) project_index(project_id: i64) -> i64 {
    var index = 0;
    while self.projects.at(index) |project| {
        if project.id == project_id {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn (self: &Core) thread_index(thread_id: i64) -> i64 {
    var index = 0;
    while self.threads.at(index) |thread| {
        if thread.id == thread_id {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn (self: &Core) session_index(thread_id: i64) -> i64 {
    var index = 0;
    while self.sessions.at(index) |session| {
        if session.thread_id == thread_id {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn (self: &var Core) disconnect_session(allocator: Allocator, thread_id: i64) -> void {
    let idx = self.session_index(thread_id);
    if idx >= 0 {
        if self.sessions.at_mut(idx) |session| {
            session.disconnect(allocator);
        }
    }
    return;
}

fn replay_parse_provider(value: &string::String) -> provider::ProviderKind {
    var kind = provider::ProviderKind::LocalEcho;
    let bytes = value.as_bytes();
    let _ = provider::parse_provider(bytes, &var kind);
    return kind;
}

fn replay_parse_effort(value: &string::String) -> provider::ReasoningEffort {
    var effort = provider::ReasoningEffort::Medium;
    let bytes = value.as_bytes();
    let _ = provider::parse_effort(bytes, &var effort);
    return effort;
}

fn replay_bind_worktree(
    allocator: Allocator,
    ws: &var workspace::WorkspaceBinding,
    branch: &string::String,
    worktree_path: &string::String
) -> mem::Error!void {
    let branch_bytes = branch.as_bytes();
    let path_bytes = worktree_path.as_bytes();
    if is_blank(branch_bytes) or is_blank(path_bytes) {
        ws.reset_to_root();
        return;
    }
    let _ = try ws.bind_worktree(allocator, branch_bytes, "", path_bytes);
    return;
}

fn replay_user_message(
    allocator: Allocator,
    id: i64,
    item: &event::UnifiedEvent
) -> mem::Error!Message {
    var text_copy = string::new(allocator);
    errdefer text_copy.deinit(allocator);
    try text_copy.append_string(allocator, &item.text);
    let detail_bytes = item.detail.as_bytes();
    var attachments = try parse_attachments(allocator, detail_bytes);
    errdefer attachments.deinit(allocator);
    var provider_copy = string::new(allocator);
    errdefer provider_copy.deinit(allocator);
    try provider_copy.append_string(allocator, &item.provider);
    var model_copy = string::new(allocator);
    errdefer model_copy.deinit(allocator);
    try model_copy.append_string(allocator, &item.model);
    return Message {
        id: id,
        turn_id: item.turn_id,
        role: MessageRole::User,
        text: move text_copy,
        attachments: move attachments,
        provider: move provider_copy,
        model: move model_copy
    };
}

fn replay_assistant_message(
    allocator: Allocator,
    id: i64,
    item: &event::UnifiedEvent
) -> mem::Error!Message {
    var text_copy = string::new(allocator);
    errdefer text_copy.deinit(allocator);
    try text_copy.append_string(allocator, &item.text);
    var provider_copy = string::new(allocator);
    errdefer provider_copy.deinit(allocator);
    try provider_copy.append_string(allocator, &item.provider);
    var model_copy = string::new(allocator);
    errdefer model_copy.deinit(allocator);
    try model_copy.append_string(allocator, &item.model);
    return Message {
        id: id,
        turn_id: item.turn_id,
        role: MessageRole::Assistant,
        text: move text_copy,
        attachments: array::new<string::String>(allocator),
        provider: move provider_copy,
        model: move model_copy
    };
}

fn apply_replayed_event(
    allocator: Allocator,
    core: &var Core,
    item: &event::UnifiedEvent
) -> mem::Error!void {
    if item.project_id >= core.next_project_id {
        core.next_project_id = item.project_id + 1;
    }
    if item.thread_id >= core.next_thread_id {
        core.next_thread_id = item.thread_id + 1;
    }
    if item.turn_id >= core.next_turn_id {
        core.next_turn_id = item.turn_id + 1;
    }

    if item.kind == event::EventKind::ProjectCreated {
        if core.project_index(item.project_id) < 0 {
            var name = string::new(allocator);
            errdefer name.deinit(allocator);
            try name.append_string(allocator, &item.text);
            var root_path = string::new(allocator);
            errdefer root_path.deinit(allocator);
            try root_path.append_string(allocator, &item.detail);
            let proj = Project { id: item.project_id, name: move name, root_path: move root_path };
            try core.projects.append(allocator, move proj);
            core.active_project_id = item.project_id;
        }
        return;
    }
    if item.kind == event::EventKind::ThreadCreated {
        if core.thread_index(item.thread_id) < 0 {
            let kind = replay_parse_provider(&item.provider);
            let effort = replay_parse_effort(&item.effort);
            var title = string::new(allocator);
            errdefer title.deinit(allocator);
            try title.append_string(allocator, &item.text);
            var model = string::new(allocator);
            errdefer model.deinit(allocator);
            try model.append_string(allocator, &item.model);
            var ws = try new_binding_from_string(allocator, &item.detail);
            errdefer ws.deinit(allocator);
            let thread = Thread {
                id: item.thread_id,
                project_id: item.project_id,
                title: move title,
                updated_at_ms: item.timestamp_ms,
                machine_state: TurnMachineState::IdleEmpty,
                provider: kind,
                model: move model,
                effort: effort,
                active_turn_id: 0,
                streaming_text: string::new(allocator),
                last_error: string::new(allocator),
                provider_session_id: string::new(allocator),
                available_models: array::new<string::String>(allocator),
                activities: array::new<ThreadActivity>(allocator),
                pending_approval: PendingApproval {
                    active: false,
                    tool_name: string::new(allocator),
                    summary: string::new(allocator)
                },
                workspace: move ws,
                messages: array::new<Message>(allocator),
                queue: array::new<QueuedTurn>(allocator)
            };
            try core.threads.append(allocator, move thread);
            core.active_project_id = item.project_id;
            core.active_thread_id = item.thread_id;
        }
        return;
    }

    let t_idx = core.thread_index(item.thread_id);
    if t_idx < 0 {
        return;
    }
    if core.threads.at_mut(t_idx) |thread| {
        if item.timestamp_ms > thread.updated_at_ms {
            thread.updated_at_ms = item.timestamp_ms;
        }
    }
    if item.kind == event::EventKind::ThreadRenamed {
        if core.threads.at_mut(t_idx) |thread| {
            thread.title.clear();
            try thread.title.append_string(allocator, &item.text);
        }
        return;
    }
    if item.kind == event::EventKind::ProviderChanged {
        let kind = replay_parse_provider(&item.provider);
        let effort = replay_parse_effort(&item.effort);
        if core.threads.at_mut(t_idx) |thread| {
            if thread.provider != kind {
                thread.provider_session_id.clear();
            }
            thread.provider = kind;
            thread.effort = effort;
            thread.model.clear();
            try thread.model.append_string(allocator, &item.model);
            if item.detail.len() > 0 {
                thread.provider_session_id.clear();
                try thread.provider_session_id.append_string(allocator, &item.detail);
            }
        }
        return;
    }
    if item.kind == event::EventKind::WorkspaceUpdated {
        if core.threads.at_mut(t_idx) |thread| {
            try replay_bind_worktree(allocator, &var thread.workspace, &item.text, &item.detail);
        }
        return;
    }
    if item.kind == event::EventKind::MessageUser {
        let msg_id = core.next_message_id;
        core.next_message_id = core.next_message_id + 1;
        let msg = try replay_user_message(allocator, msg_id, item);
        if core.threads.at_mut(t_idx) |thread| {
            try thread.messages.append(allocator, move msg);
        } else {
            msg.deinit(allocator);
        }
        return;
    }
    if item.kind == event::EventKind::MessageCompleted {
        let msg_id = core.next_message_id;
        core.next_message_id = core.next_message_id + 1;
        let msg = try replay_assistant_message(allocator, msg_id, item);
        if core.threads.at_mut(t_idx) |thread| {
            try thread.messages.append(allocator, move msg);
            thread.last_error.clear();
            thread.machine_state = TurnMachineState::IdleEmpty;
        } else {
            msg.deinit(allocator);
        }
        return;
    }
    if item.kind == event::EventKind::TurnCompleted {
        if core.threads.at_mut(t_idx) |thread| {
            thread.last_error.clear();
            thread.machine_state = TurnMachineState::IdleEmpty;
        }
        return;
    }
    if item.kind == event::EventKind::TurnFailed {
        if core.threads.at_mut(t_idx) |thread| {
            thread.last_error.clear();
            try thread.last_error.append_string(allocator, &item.detail);
            thread.machine_state = TurnMachineState::FailedEmpty;
        }
        return;
    }
    return;
}

pub fn new_core_with_store(
    allocator: Allocator,
    project_name: []u8,
    project_path: []u8,
    store_path: []u8
) -> mem::Error!Core {
    var core = build_empty_core(allocator);
    errdefer core.deinit(allocator);

    if !is_blank(store_path) {
        var raw = string::new(allocator);
        defer raw.deinit(allocator);
        if try store::read_file_bytes(allocator, store_path, &var raw) {
            var loaded = array::new<event::UnifiedEvent>(allocator);
            defer loaded.deinit(allocator);
            let raw_bytes = raw.as_bytes();
            let _ = try store::parse_jsonl_tolerant(allocator, raw_bytes, &var loaded);
            while loaded.len() > 0 {
                if loaded.remove(0) |ev| {
                    var ev_owned = move ev;
                    errdefer ev_owned.deinit(allocator);
                    try apply_replayed_event(allocator, &var core, &ev_owned);
                    try core.store.append_replayed(allocator, move ev_owned);
                } else |_| {
                    break;
                }
            }
        }
        try core.store.attach_path(allocator, store_path);
    }

    if core.projects.len() == 0 {
        var initial_name = project_name;
        if is_blank(initial_name) {
            initial_name = "Kasugai";
        }
        var initial_path = project_path;
        if is_blank(initial_path) {
            initial_path = ".";
        }
        let project_id = try core.add_project(allocator, initial_name, initial_path);
        let _ = try core.create_thread(
            allocator,
            project_id,
            "スレッド 1",
            provider::ProviderKind::LocalEcho,
            provider::provider_default_model(provider::ProviderKind::LocalEcho),
            provider::ReasoningEffort::Medium
        );
    }
    return move core;
}

pub fn new_core(allocator: Allocator, project_name: []u8, project_path: []u8) -> mem::Error!Core {
    return new_core_with_store(allocator, project_name, project_path, "");
}

fn record_project_created(
    allocator: Allocator,
    event_store: &var store::EventStore,
    project_id: i64,
    name: &string::String,
    root_path: &string::String
) -> mem::Error!void {
    let name_bytes = name.as_bytes();
    let path_bytes = root_path.as_bytes();
    let _ = try event_store.record(
        allocator,
        project_id,
        0,
        0,
        event::EventKind::ProjectCreated,
        "",
        "",
        "",
        name_bytes,
        path_bytes
    );
    return;
}

fn record_thread_created(
    allocator: Allocator,
    event_store: &var store::EventStore,
    project_id: i64,
    thread_id: i64,
    kind: provider::ProviderKind,
    effort: provider::ReasoningEffort,
    title: &string::String,
    model: &string::String,
    root_path: &string::String
) -> mem::Error!void {
    let title_bytes = title.as_bytes();
    let model_bytes = model.as_bytes();
    let root_bytes = root_path.as_bytes();
    let _ = try event_store.record(
        allocator,
        project_id,
        thread_id,
        0,
        event::EventKind::ThreadCreated,
        provider::provider_id(kind),
        model_bytes,
        provider::effort_id(effort),
        title_bytes,
        root_bytes
    );
    return;
}

fn new_binding_from_string(
    allocator: Allocator,
    root_path: &string::String
) -> mem::Error!workspace::WorkspaceBinding {
    let bytes = root_path.as_bytes();
    return workspace::new_root_binding(allocator, bytes);
}

pub fn (self: &var Core) set_orchestrator_bridge(
    allocator: Allocator,
    socket_path: []u8,
    ctl_bin: []u8
) -> mem::Error!void {
    self.bridge_socket.clear();
    if !is_blank(socket_path) {
        try self.bridge_socket.append_bytes(allocator, socket_path);
    }
    self.bridge_bin.clear();
    if !is_blank(ctl_bin) {
        try self.bridge_bin.append_bytes(allocator, ctl_bin);
    }
    return;
}

pub fn (self: &var Core) set_provider_command_override(
    allocator: Allocator,
    kind: provider::ProviderKind,
    executable: []u8,
    args_nl: []u8
) -> mem::Error!void {
    var found: i64 = -1;
    var idx: i64 = 0;
    while self.command_overrides.at(idx) |ov| {
        if ov.kind == kind {
            found = idx;
            break;
        }
        idx = idx + 1;
    }
    if found >= 0 {
        if self.command_overrides.remove(found) |old| {
            old.deinit(allocator);
        } else |_| {}
    }
    if is_blank(executable) {
        return;
    }
    let entry = try provider::new_command_override(allocator, kind, executable, args_nl);
    return self.command_overrides.append(allocator, move entry);
}

pub fn (self: &var Core) add_project(
    allocator: Allocator,
    name: []u8,
    root_path: []u8
) -> mem::Error!i64 {
    if is_blank(name) or is_blank(root_path) {
        return -1;
    }
    let id = self.next_project_id;
    self.next_project_id = self.next_project_id + 1;

    var owned_name = try string::from_bytes(allocator, name);
    errdefer owned_name.deinit(allocator);
    string::trim_space_in_place(&var owned_name);

    var owned_path = try string::from_bytes(allocator, root_path);
    errdefer owned_path.deinit(allocator);
    string::trim_space_in_place(&var owned_path);

    try record_project_created(allocator, &var self.store, id, &owned_name, &owned_path);

    let project = Project {
        id: id,
        name: move owned_name,
        root_path: move owned_path
    };
    try self.projects.append(allocator, move project);
    self.active_project_id = id;
    return id;
}

pub fn (self: &var Core) select_project(project_id: i64) -> bool {
    if self.project_index(project_id) < 0 {
        return false;
    }
    self.active_project_id = project_id;
    var index = 0;
    while self.threads.at(index) |thread| {
        if thread.project_id == project_id {
            self.active_thread_id = thread.id;
            return true;
        }
        index = index + 1;
    }
    return true;
}

pub fn (self: &var Core) create_thread(
    allocator: Allocator,
    project_id: i64,
    title: []u8,
    kind: provider::ProviderKind,
    model: []u8,
    effort: provider::ReasoningEffort
) -> mem::Error!i64 {
    let p_index = self.project_index(project_id);
    if p_index < 0 {
        return -1;
    }
    var root_copy = string::new(allocator);
    defer root_copy.deinit(allocator);
    if self.projects.at(p_index) |project| {
        try root_copy.append_string(allocator, &project.root_path);
    }

    let id = self.next_thread_id;
    self.next_thread_id = self.next_thread_id + 1;

    var owned_title = string::new(allocator);
    errdefer owned_title.deinit(allocator);
    if is_blank(title) {
        try owned_title.append_bytes(allocator, "スレッド ");
        try fmt::append_i64(allocator, &var owned_title, id);
    } else {
        try owned_title.append_bytes(allocator, title);
        string::trim_space_in_place(&var owned_title);
    }

    var owned_model = string::new(allocator);
    errdefer owned_model.deinit(allocator);
    if is_blank(model) {
        try owned_model.append_bytes(allocator, provider::provider_default_model(kind));
    } else {
        try owned_model.append_bytes(allocator, model);
        string::trim_space_in_place(&var owned_model);
    }

    var ws = try new_binding_from_string(allocator, &root_copy);
    errdefer ws.deinit(allocator);

    try record_thread_created(
        allocator,
        &var self.store,
        project_id,
        id,
        kind,
        effort,
        &owned_title,
        &owned_model,
        &root_copy
    );

    let thread = Thread {
        id: id,
        project_id: project_id,
        title: move owned_title,
        updated_at_ms: store::unix_millis(),
        machine_state: TurnMachineState::IdleEmpty,
        provider: kind,
        model: move owned_model,
        effort: effort,
        active_turn_id: 0,
        streaming_text: string::new(allocator),
        last_error: string::new(allocator),
        provider_session_id: string::new(allocator),
        available_models: array::new<string::String>(allocator),
        activities: array::new<ThreadActivity>(allocator),
        pending_approval: PendingApproval {
            active: false,
            tool_name: string::new(allocator),
            summary: string::new(allocator)
        },
        workspace: move ws,
        messages: array::new<Message>(allocator),
        queue: array::new<QueuedTurn>(allocator)
    };
    try self.threads.append(allocator, move thread);
    self.active_project_id = project_id;
    self.active_thread_id = id;
    return id;
}

pub fn (self: &var Core) select_thread(thread_id: i64) -> bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    if self.threads.at(index) |thread| {
        self.active_project_id = thread.project_id;
        self.active_thread_id = thread.id;
        return true;
    }
    return false;
}

pub fn (self: &var Core) rename_thread(
    allocator: Allocator,
    thread_id: i64,
    title: []u8
) -> mem::Error!bool {
    if is_blank(title) {
        return false;
    }
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var project_id: i64 = 0;
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    var title_copy = string::new(allocator);
    defer title_copy.deinit(allocator);
    var empty_detail = string::new(allocator);
    defer empty_detail.deinit(allocator);

    if self.threads.at_mut(index) |thread| {
        thread.title.clear();
        try thread.title.append_bytes(allocator, title);
        string::trim_space_in_place(&var thread.title);
        thread.updated_at_ms = store::unix_millis();
        project_id = thread.project_id;
        kind = thread.provider;
        effort = thread.effort;
        try model_copy.append_string(allocator, &thread.model);
        try title_copy.append_string(allocator, &thread.title);
    } else {
        return false;
    }
    try record_event_strings(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        0,
        event::EventKind::ThreadRenamed,
        kind,
        &model_copy,
        effort,
        &title_copy,
        &empty_detail
    );
    return true;
}

fn record_event_with_model(
    allocator: Allocator,
    event_store: &var store::EventStore,
    project_id: i64,
    thread_id: i64,
    turn_id: i64,
    kind: event::EventKind,
    provider_kind: provider::ProviderKind,
    model: &string::String,
    effort: provider::ReasoningEffort,
    text: []u8,
    detail: []u8
) -> mem::Error!void {
    let model_bytes = model.as_bytes();
    let _ = try event_store.record(
        allocator,
        project_id,
        thread_id,
        turn_id,
        kind,
        provider::provider_id(provider_kind),
        model_bytes,
        provider::effort_id(effort),
        text,
        detail
    );
    return;
}

fn record_event_strings(
    allocator: Allocator,
    event_store: &var store::EventStore,
    project_id: i64,
    thread_id: i64,
    turn_id: i64,
    kind: event::EventKind,
    provider_kind: provider::ProviderKind,
    model: &string::String,
    effort: provider::ReasoningEffort,
    text: &string::String,
    detail: &string::String
) -> mem::Error!void {
    let model_bytes = model.as_bytes();
    let text_bytes = text.as_bytes();
    let detail_bytes = detail.as_bytes();
    let _ = try event_store.record(
        allocator,
        project_id,
        thread_id,
        turn_id,
        kind,
        provider::provider_id(provider_kind),
        model_bytes,
        provider::effort_id(effort),
        text_bytes,
        detail_bytes
    );
    return;
}

fn record_event_with_detail_string(
    allocator: Allocator,
    event_store: &var store::EventStore,
    project_id: i64,
    thread_id: i64,
    turn_id: i64,
    kind: event::EventKind,
