fn build_user_message(
    allocator: Allocator,
    id: i64,
    turn_id: i64,
    queued: &QueuedTurn,
    provider_kind: provider::ProviderKind,
    model: &string::String
) -> mem::Error!Message {
    var msg_text = string::new(allocator);
    errdefer msg_text.deinit(allocator);
    try msg_text.append_string(allocator, &queued.text);
    var msg_attachments = try clone_string_array(allocator, &queued.attachments);
    errdefer msg_attachments.deinit(allocator);
    var msg_provider = try string::from_bytes(allocator, provider::provider_id(provider_kind));
    errdefer msg_provider.deinit(allocator);
    var msg_model = string::new(allocator);
    errdefer msg_model.deinit(allocator);
    try msg_model.append_string(allocator, model);
    return Message {
        id: id,
        turn_id: turn_id,
        role: MessageRole::User,
        text: move msg_text,
        attachments: move msg_attachments,
        provider: move msg_provider,
        model: move msg_model
    };
}

fn build_assistant_message(
    allocator: Allocator,
    id: i64,
    turn_id: i64,
    text: &string::String,
    provider_kind: provider::ProviderKind,
    model: &string::String
) -> mem::Error!Message {
    var msg_text = string::new(allocator);
    errdefer msg_text.deinit(allocator);
    try msg_text.append_string(allocator, text);
    var msg_provider = try string::from_bytes(allocator, provider::provider_id(provider_kind));
    errdefer msg_provider.deinit(allocator);
    var msg_model = string::new(allocator);
    errdefer msg_model.deinit(allocator);
    try msg_model.append_string(allocator, model);
    return Message {
        id: id,
        turn_id: turn_id,
        role: MessageRole::Assistant,
        text: move msg_text,
        attachments: array::new<string::String>(allocator),
        provider: move msg_provider,
        model: move msg_model
    };
}

fn run_local_turn_strings(
    allocator: Allocator,
    kind: provider::ProviderKind,
    model: &string::String,
    effort: provider::ReasoningEffort,
    prompt: &string::String,
    attachment_count: i64,
    suppress_telemetry: bool
) -> mem::Error!provider::LocalTurnOutput {
    let model_bytes = model.as_bytes();
    let prompt_bytes = prompt.as_bytes();
    return provider::execute_local_turn(
        allocator,
        kind,
        model_bytes,
        effort,
        prompt_bytes,
        attachment_count,
        suppress_telemetry
    );
}

fn append_delta_string(
    allocator: Allocator,
    core: &var Core,
    thread_id: i64,
    chunk: &string::String
) -> mem::Error!bool {
    let bytes = chunk.as_bytes();
    return core.append_active_delta(allocator, thread_id, bytes);
}

fn finish_turn_string(
    allocator: Allocator,
    core: &var Core,
    thread_id: i64,
    text: &string::String
) -> mem::Error!bool {
    let bytes = text.as_bytes();
    return core.finish_active_turn(allocator, thread_id, bytes);
}

fn fail_turn_string(
    allocator: Allocator,
    core: &var Core,
    thread_id: i64,
    reason: &string::String
) -> mem::Error!bool {
    let bytes = reason.as_bytes();
    return core.fail_active_turn(allocator, thread_id, bytes);
}

fn request_approval_strings(
    allocator: Allocator,
    core: &var Core,
    thread_id: i64,
    tool_name: &string::String,
    summary: &string::String
) -> mem::Error!bool {
    let tool_bytes = tool_name.as_bytes();
    let sum_bytes = summary.as_bytes();
    return core.request_tool_approval(allocator, thread_id, tool_bytes, sum_bytes);
}

pub fn (self: &var Core) set_thread_provider(
    allocator: Allocator,
    thread_id: i64,
    kind: provider::ProviderKind,
    model: []u8,
    effort: provider::ReasoningEffort
) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var project_id: i64 = 0;
    var provider_changed = false;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    if self.threads.at_mut(index) |thread| {
        if thread.provider != kind {
            provider_changed = true;
            thread.provider_session_id.clear();
            thread.available_models.clear(allocator);
        }
        thread.provider = kind;
        thread.effort = effort;
        thread.model.clear();
        if is_blank(model) or (provider_changed and mem::equal_bytes(model, "local-echo")) {
            try thread.model.append_bytes(allocator, provider::provider_default_model(kind));
        } else {
            try thread.model.append_bytes(allocator, model);
            string::trim_space_in_place(&var thread.model);
        }
        project_id = thread.project_id;
        try model_copy.append_string(allocator, &thread.model);
    } else {
        return false;
    }
    if provider_changed {
        self.disconnect_session(allocator, thread_id);
    }
    try record_event_with_model(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        0,
        event::EventKind::ProviderChanged,
        kind,
        &model_copy,
        effort,
        provider::provider_display_name(kind),
        ""
    );
    return true;
}

pub fn (self: &var Core) set_telemetry_suppression(enabled: bool) -> void {
    self.suppress_telemetry = enabled;
    return;
}

pub fn (self: &var Core) set_auto_approve_tools(
    allocator: Allocator,
    enabled: bool
) -> mem::Error!bool {
    var changed = self.auto_approve_tools != enabled;
    self.auto_approve_tools = enabled;
    if !enabled {
        return changed;
    }
    var pending_ids = array::new<i64>(allocator);
    defer pending_ids.deinit(allocator);
    var idx: i64 = 0;
    while self.threads.at(idx) |thread| {
        if thread.machine_state == TurnMachineState::AwaitingApprovalEmpty or
            thread.machine_state == TurnMachineState::AwaitingApprovalQueued {
            try pending_ids.append(allocator, thread.id);
        }
        idx = idx + 1;
    }
    while pending_ids.len() > 0 {
        if pending_ids.remove(0) |tid| {
            if try self.resolve_tool_approval(allocator, tid, true) {
                changed = true;
            }
        } else |_| {
            break;
        }
    }
    return changed;
}

pub fn (self: &var Core) bind_worktree(
    allocator: Allocator,
    thread_id: i64,
    branch: []u8,
    base_ref: []u8,
    worktree_path: []u8
) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var project_id: i64 = 0;
    var updated = false;
    if self.threads.at_mut(index) |thread| {
        updated = try thread.workspace.bind_worktree(allocator, branch, base_ref, worktree_path);
        project_id = thread.project_id;
    }
    if !updated {
        return false;
    }
    self.disconnect_session(allocator, thread_id);
    let _ = try self.store.record(
        allocator,
        project_id,
        thread_id,
        0,
        event::EventKind::WorkspaceUpdated,
        "",
        "",
        "",
        branch,
        worktree_path
    );
    return true;
}

pub fn (self: &var Core) reset_worktree(allocator: Allocator, thread_id: i64) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var project_id: i64 = 0;
    if self.threads.at_mut(index) |thread| {
        thread.workspace.reset_to_root();
        project_id = thread.project_id;
    }
    self.disconnect_session(allocator, thread_id);
    let _ = try self.store.record(
        allocator,
        project_id,
        thread_id,
        0,
        event::EventKind::WorkspaceUpdated,
        "",
        "",
        "",
        "",
        ""
    );
    return true;
}

pub fn (self: &var Core) update_diff_stats(
    thread_id: i64,
    files_changed: i64,
    insertions: i64,
    deletions: i64
) -> bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    if self.threads.at_mut(index) |thread| {
        thread.workspace.update_diff_stats(files_changed, insertions, deletions);
        return true;
    }
    return false;
}

pub fn (self: &var Core) enqueue_turn(
    allocator: Allocator,
    thread_id: i64,
    text: []u8,
    attachments_nl: []u8
) -> mem::Error!i64 {
    if is_blank(text) {
        return -1;
    }
    let index = self.thread_index(thread_id);
    if index < 0 {
        return -1;
    }
    var owned_text = try string::from_bytes(allocator, text);
    errdefer owned_text.deinit(allocator);
    string::trim_space_in_place(&var owned_text);
    if owned_text.len() == 0 {
        owned_text.deinit(allocator);
        return -1;
    }
    var attachments = try parse_attachments(allocator, attachments_nl);
    errdefer attachments.deinit(allocator);

    let turn_id = self.next_turn_id;
    self.next_turn_id = self.next_turn_id + 1;

    var project_id: i64 = 0;
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    var detail = string::new(allocator);
    defer detail.deinit(allocator);
    try join_attachments(allocator, &attachments, &var detail);
    var text_copy = string::new(allocator);
    defer text_copy.deinit(allocator);
    try text_copy.append_string(allocator, &owned_text);

    if self.threads.at_mut(index) |thread| {
        let step = thread_turn_advance(thread.machine_state, TurnMachineEvent::Enqueue);
        if step.outcome != TurnMachineOutcome::Queued {
            owned_text.deinit(allocator);
            attachments.deinit(allocator);
            return -1;
        }
        let queued = QueuedTurn {
            turn_id: turn_id,
            text: move owned_text,
            attachments: move attachments
        };
        try thread.queue.append(allocator, move queued);
        thread.machine_state = step.state;
        thread.updated_at_ms = store::unix_millis();
        project_id = thread.project_id;
        kind = thread.provider;
        effort = thread.effort;
        try model_copy.append_string(allocator, &thread.model);
    } else {
        owned_text.deinit(allocator);
        attachments.deinit(allocator);
        return -1;
    }

    try record_event_strings(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        turn_id,
        event::EventKind::TurnEnqueued,
        kind,
        &model_copy,
        effort,
        &text_copy,
        &detail
    );
    return turn_id;
}

pub fn (self: &var Core) cancel_queued_turn(
    allocator: Allocator,
    thread_id: i64,
    turn_id: i64
) -> bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    if self.threads.at_mut(index) |thread| {
        var found: i64 = -1;
        var q_index: i64 = 0;
        while thread.queue.at(q_index) |item| {
            if item.turn_id == turn_id {
                found = q_index;
                break;
            }
            q_index = q_index + 1;
        }
        if found < 0 {
            return false;
        }
        var ev = TurnMachineEvent::CancelMoreQueued;
        if thread.queue.len() == 1 {
            ev = TurnMachineEvent::CancelLastQueued;
        }
        let step = thread_turn_advance(thread.machine_state, ev);
        if step.outcome != TurnMachineOutcome::QueueItemRemoved {
            return false;
        }
        if thread.queue.remove(found) |removed| {
            removed.deinit(allocator);
            thread.machine_state = step.state;
            return true;
        } else |_| {
            return false;
        }
    }
    return false;
}

pub fn (self: &var Core) begin_next_queued_turn(
    allocator: Allocator,
    thread_id: i64
) -> mem::Error!i64 {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return -1;
    }
    var project_id: i64 = 0;
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    var user_text_copy = string::new(allocator);
    defer user_text_copy.deinit(allocator);
    var detail = string::new(allocator);
    defer detail.deinit(allocator);
    var started_turn_id: i64 = -1;

    if self.threads.at_mut(index) |thread| {
        if thread.queue.len() == 0 {
            return -1;
        }
        var ev = TurnMachineEvent::StartMoreQueued;
        if thread.queue.len() == 1 {
            ev = TurnMachineEvent::StartLastQueued;
        }
        let step = thread_turn_advance(thread.machine_state, ev);
        if step.outcome != TurnMachineOutcome::TurnStarted {
            return -1;
        }
        if thread.queue.remove(0) |queued| {
            defer queued.deinit(allocator);
            started_turn_id = queued.turn_id;
            try user_text_copy.append_string(allocator, &queued.text);
            try join_attachments(allocator, &queued.attachments, &var detail);
            try model_copy.append_string(allocator, &thread.model);

            let message_id = self.next_message_id;
            self.next_message_id = self.next_message_id + 1;
            let user_msg = try build_user_message(
                allocator,
                message_id,
                started_turn_id,
                &queued,
                thread.provider,
                &thread.model
            );
            try thread.messages.append(allocator, move user_msg);
            thread.machine_state = step.state;
            thread.active_turn_id = started_turn_id;
            thread.streaming_text.clear();
            thread.last_error.clear();
            thread.pending_approval.active = false;
            thread.pending_approval.tool_name.clear();
            thread.pending_approval.summary.clear();
            project_id = thread.project_id;
            kind = thread.provider;
            effort = thread.effort;
        } else |_| {
            return -1;
        }
    } else {
        return -1;
    }

    try record_event_with_model(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        started_turn_id,
        event::EventKind::TurnStarted,
        kind,
        &model_copy,
        effort,
        "",
        ""
    );
    try record_event_strings(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        started_turn_id,
        event::EventKind::MessageUser,
        kind,
        &model_copy,
        effort,
        &user_text_copy,
        &detail
    );
    return started_turn_id;
}

pub fn (self: &var Core) append_active_delta(
    allocator: Allocator,
    thread_id: i64,
    chunk: []u8
) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var project_id: i64 = 0;
    var turn_id: i64 = 0;
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    if self.threads.at_mut(index) |thread| {
        if thread.machine_state != TurnMachineState::RunningEmpty and
            thread.machine_state != TurnMachineState::RunningQueued {
            return false;
        }
        try thread.streaming_text.append_bytes(allocator, chunk);
        project_id = thread.project_id;
        turn_id = thread.active_turn_id;
        kind = thread.provider;
        effort = thread.effort;
        try model_copy.append_string(allocator, &thread.model);
    } else {
        return false;
    }
    try record_event_with_model(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        turn_id,
        event::EventKind::MessageDelta,
        kind,
        &model_copy,
        effort,
        chunk,
        ""
    );
    return true;
}

pub fn (self: &var Core) request_tool_approval(
    allocator: Allocator,
    thread_id: i64,
    tool_name: []u8,
    summary: []u8
) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var project_id: i64 = 0;
    var turn_id: i64 = 0;
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    if self.threads.at_mut(index) |thread| {
        let step = thread_turn_advance(thread.machine_state, TurnMachineEvent::RequestApproval);
        if step.outcome != TurnMachineOutcome::ApprovalRequested {
            return false;
        }
        thread.machine_state = step.state;
        thread.pending_approval.active = true;
        thread.pending_approval.tool_name.clear();
        try thread.pending_approval.tool_name.append_bytes(allocator, tool_name);
        thread.pending_approval.summary.clear();
        try thread.pending_approval.summary.append_bytes(allocator, summary);
        project_id = thread.project_id;
        turn_id = thread.active_turn_id;
        kind = thread.provider;
        effort = thread.effort;
        try model_copy.append_string(allocator, &thread.model);
    } else {
        return false;
    }
    try record_event_with_model(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        turn_id,
        event::EventKind::ToolApprovalRequested,
        kind,
        &model_copy,
        effort,
        tool_name,
        summary
    );
    return true;
}

pub fn (self: &var Core) resolve_tool_approval(
    allocator: Allocator,
    thread_id: i64,
    approve: bool
) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    let s_idx = self.session_index(thread_id);
    if s_idx >= 0 {
        if self.sessions.at_mut(s_idx) |session| {
            let _ = try session.resolve_permission(allocator, approve);
        }
    }
    var project_id: i64 = 0;
    var turn_id: i64 = 0;
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    var tool_copy = string::new(allocator);
    defer tool_copy.deinit(allocator);
    if self.threads.at_mut(index) |thread| {
        var ev = TurnMachineEvent::DenyTool;
        if approve {
            ev = TurnMachineEvent::ApproveTool;
        }
        let step = thread_turn_advance(thread.machine_state, ev);
        if step.outcome != TurnMachineOutcome::ApprovalGranted and
            step.outcome != TurnMachineOutcome::ApprovalDenied {
            return false;
        }
        thread.machine_state = step.state;
        try tool_copy.append_string(allocator, &thread.pending_approval.tool_name);
        thread.pending_approval.active = false;
        thread.pending_approval.tool_name.clear();
        thread.pending_approval.summary.clear();
        turn_id = thread.active_turn_id;
        if !approve {
            thread.active_turn_id = 0;
            thread.streaming_text.clear();
            thread.last_error.clear();
            try thread.last_error.append_bytes(allocator, "ツール実行が拒否されました");
        }
        project_id = thread.project_id;
        kind = thread.provider;
        effort = thread.effort;
        try model_copy.append_string(allocator, &thread.model);
    } else {
        return false;
    }
    var decision: []u8 = "denied";
    if approve {
        decision = "approved";
    }
    try record_event_with_detail_string(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        turn_id,
        event::EventKind::ToolApprovalResolved,
        kind,
        &model_copy,
        effort,
        decision,
        &tool_copy
    );
    return true;
}

pub fn (self: &var Core) finish_active_turn(
    allocator: Allocator,
    thread_id: i64,
    assistant_text: []u8
) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var project_id: i64 = 0;
    var turn_id: i64 = 0;
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    var final_text_copy = string::new(allocator);
    defer final_text_copy.deinit(allocator);
    var empty_detail = string::new(allocator);
    defer empty_detail.deinit(allocator);

    if self.threads.at_mut(index) |thread| {
        let step = thread_turn_advance(thread.machine_state, TurnMachineEvent::CompleteTurn);
        if step.outcome != TurnMachineOutcome::TurnCompleted {
            return false;
        }
        if mem::len(assistant_text) > 0 {
            try final_text_copy.append_bytes(allocator, assistant_text);
        } else {
            try final_text_copy.append_string(allocator, &thread.streaming_text);
        }
        try model_copy.append_string(allocator, &thread.model);
        let message_id = self.next_message_id;
        self.next_message_id = self.next_message_id + 1;
        turn_id = thread.active_turn_id;
        let assistant_msg = try build_assistant_message(
            allocator,
            message_id,
            turn_id,
            &final_text_copy,
            thread.provider,
            &thread.model
        );
        try thread.messages.append(allocator, move assistant_msg);
        thread.machine_state = step.state;
        thread.updated_at_ms = store::unix_millis();
        thread.active_turn_id = 0;
        thread.streaming_text.clear();
        try finalize_running_activities(allocator, &var thread.activities, "completed");
        project_id = thread.project_id;
        kind = thread.provider;
        effort = thread.effort;
    } else {
        return false;
    }

    try record_event_strings(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        turn_id,
        event::EventKind::MessageCompleted,
        kind,
        &model_copy,
        effort,
        &final_text_copy,
        &empty_detail
    );
    try record_event_with_model(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        turn_id,
        event::EventKind::TurnCompleted,
        kind,
        &model_copy,
        effort,
        "",
        ""
    );
    return true;
}

pub fn (self: &var Core) fail_active_turn(
    allocator: Allocator,
    thread_id: i64,
    reason: []u8
) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var project_id: i64 = 0;
    var turn_id: i64 = 0;
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);

    if self.threads.at_mut(index) |thread| {
        let step = thread_turn_advance(thread.machine_state, TurnMachineEvent::FailTurn);
        if step.outcome != TurnMachineOutcome::TurnFailed {
            return false;
        }
        turn_id = thread.active_turn_id;
        thread.machine_state = step.state;
        thread.updated_at_ms = store::unix_millis();
        thread.active_turn_id = 0;
        thread.streaming_text.clear();
        try finalize_running_activities(allocator, &var thread.activities, "failed");
        thread.last_error.clear();
        try thread.last_error.append_bytes(allocator, reason);
        project_id = thread.project_id;
        kind = thread.provider;
        effort = thread.effort;
        try model_copy.append_string(allocator, &thread.model);
    } else {
        return false;
    }

    try record_event_with_model(
        allocator,
        &var self.store,
        project_id,
        thread_id,
        turn_id,
        event::EventKind::TurnFailed,
        kind,
        &model_copy,
        effort,
        "",
        reason
    );
    return true;
}

pub fn (self: &var Core) cancel_active_turn(
    allocator: Allocator,
    thread_id: i64
) -> mem::Error!bool {
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var awaiting = false;
    if self.threads.at(index) |thread| {
        if thread.machine_state == TurnMachineState::AwaitingApprovalEmpty or
            thread.machine_state == TurnMachineState::AwaitingApprovalQueued {
            awaiting = true;
        }
    }
    if awaiting {
        return self.resolve_tool_approval(allocator, thread_id, false);
    }
    let s_idx = self.session_index(thread_id);
    if s_idx >= 0 {
        if self.sessions.at_mut(s_idx) |session| {
            let _ = try session.cancel_turn(allocator);
        }
    }
    return self.fail_active_turn(allocator, thread_id, "ターンを停止しました");
}

fn finalize_running_activities(
    allocator: Allocator,
    activities: &var array::Array<ThreadActivity>,
    final_status: []u8
) -> mem::Error!void {
    var idx: i64 = 0;
    while activities.at_mut(idx) |act| {
        let st_bytes = act.status.as_bytes();
        let is_running = mem::equal_bytes(st_bytes, "running");
        if is_running {
            act.status.clear();
            try act.status.append_bytes(allocator, final_status);
        }
        idx = idx + 1;
    }
    return;
}

fn upsert_thread_activity(
    allocator: Allocator,
    thread: &var Thread,
    call_id: &string::String,
    kind: &string::String,
    title: &string::String,
    status: &string::String,
    detail: &string::String
) -> mem::Error!void {
    let cid_bytes = call_id.as_bytes();
    if mem::len(cid_bytes) > 0 {
        var idx: i64 = thread.activities.len() - 1;
        while idx >= 0 {
            if thread.activities.at_mut(idx) |existing| {
                let ex_cid = existing.call_id.as_bytes();
                if existing.turn_id == thread.active_turn_id and mem::equal_bytes(ex_cid, cid_bytes) {
                    if title.len() > 0 {
                        existing.title.clear();
                        try existing.title.append_string(allocator, title);
                    }
                    if status.len() > 0 {
                        existing.status.clear();
                        try existing.status.append_string(allocator, status);
                    }
                    if detail.len() > 0 {
                        let k_bytes = kind.as_bytes();
                        if mem::equal_bytes(k_bytes, "thought") {
                            if existing.detail.len() < 400 {
                                try existing.detail.append_string(allocator, detail);
                            }
                        } else {
                            existing.detail.clear();
                            try existing.detail.append_string(allocator, detail);
                        }
                    }
                    return;
                }
            }
            idx = idx - 1;
        }
    }
    while thread.activities.len() >= 40 {
        if thread.activities.remove(0) |old| {
            old.deinit(allocator);
        } else |_| {
            break;
        }
    }
    var owned_cid = string::new(allocator);
    errdefer owned_cid.deinit(allocator);
    try owned_cid.append_string(allocator, call_id);
    var owned_kind = string::new(allocator);
    errdefer owned_kind.deinit(allocator);
    if kind.len() > 0 {
        try owned_kind.append_string(allocator, kind);
    } else {
        try owned_kind.append_bytes(allocator, "tool");
    }
    var owned_title = string::new(allocator);
    errdefer owned_title.deinit(allocator);
    if title.len() > 0 {
        try owned_title.append_string(allocator, title);
    } else {
        try owned_title.append_bytes(allocator, "処理中");
    }
    var owned_status = string::new(allocator);
    errdefer owned_status.deinit(allocator);
    if status.len() > 0 {
        try owned_status.append_string(allocator, status);
    } else {
        try owned_status.append_bytes(allocator, "running");
    }
    var owned_detail = string::new(allocator);
    errdefer owned_detail.deinit(allocator);
    try owned_detail.append_string(allocator, detail);
    let act = ThreadActivity {
        turn_id: thread.active_turn_id,
        call_id: move owned_cid,
        kind: move owned_kind,
        title: move owned_title,
        status: move owned_status,
        detail: move owned_detail
    };
    return thread.activities.append(allocator, move act);
}

fn is_default_or_blank_model(model: &string::String) -> bool {
    let bytes = model.as_bytes();
    return is_blank(bytes) or mem::equal_bytes(bytes, "default");
}

fn apply_session_events(
    allocator: Allocator,
    core: &var Core,
    thread_id: i64,
    events: &array::Array<provider::SessionEvent>
) -> mem::Error!bool {
    var changed = false;
    var completed = false;
    var idx: i64 = 0;
    while events.at(idx) |ev| {
        if ev.kind == provider::SessionEventKind::SessionIdUpdated {
            let t_idx = core.thread_index(thread_id);
            if t_idx >= 0 {
                var proj_id: i64 = 0;
                var kind = provider::ProviderKind::LocalEcho;
                var effort = provider::ReasoningEffort::Medium;
                var model_copy = string::new(allocator);
                defer model_copy.deinit(allocator);
                if core.threads.at_mut(t_idx) |thread| {
                    thread.provider_session_id.clear();
                    try thread.provider_session_id.append_string(allocator, &ev.session_id);
                    proj_id = thread.project_id;
                    kind = thread.provider;
                    effort = thread.effort;
                    try model_copy.append_string(allocator, &thread.model);
                    changed = true;
                }
                if changed {
                    try record_event_with_detail_string(
                        allocator,
                        &var core.store,
                        proj_id,
                        thread_id,
                        0,
                        event::EventKind::ProviderChanged,
                        kind,
                        &model_copy,
                        effort,
                        provider::provider_display_name(kind),
                        &ev.session_id
                    );
                }
            }
        } else if ev.kind == provider::SessionEventKind::ModelsUpdated {
            let t_idx = core.thread_index(thread_id);
            if t_idx >= 0 {
                if core.threads.at_mut(t_idx) |thread| {
                    try replace_string_array(allocator, &var thread.available_models, &ev.models);
                    if is_default_or_blank_model(&thread.model) and ev.current_model.len() > 0 {
                        thread.model.clear();
                        try thread.model.append_string(allocator, &ev.current_model);
                    }
                    changed = true;
                }
            }
        } else if ev.kind == provider::SessionEventKind::Activity {
            let t_idx = core.thread_index(thread_id);
            if t_idx >= 0 {
                var proj_id: i64 = 0;
                var turn_id: i64 = 0;
                var kind = provider::ProviderKind::LocalEcho;
                var effort = provider::ReasoningEffort::Medium;
                var model_copy = string::new(allocator);
                defer model_copy.deinit(allocator);
                if core.threads.at_mut(t_idx) |thread| {
                    try upsert_thread_activity(
                        allocator,
                        thread,
                        &ev.call_id,
                        &ev.activity_kind,
                        &ev.text,
                        &ev.activity_status,
                        &ev.detail
                    );
                    proj_id = thread.project_id;
                    turn_id = thread.active_turn_id;
                    kind = thread.provider;
                    effort = thread.effort;
                    try model_copy.append_string(allocator, &thread.model);
                    changed = true;
                }
                if changed {
                    try record_event_strings(
                        allocator,
                        &var core.store,
                        proj_id,
                        thread_id,
                        turn_id,
                        event::EventKind::Activity,
                        kind,
                        &model_copy,
                        effort,
                        &ev.text,
                        &ev.detail
                    );
                }
            }
        } else if ev.kind == provider::SessionEventKind::Delta {
            if try append_delta_string(allocator, core, thread_id, &ev.text) {
                changed = true;
            }
        } else if ev.kind == provider::SessionEventKind::PermissionRequested {
            if try request_approval_strings(allocator, core, thread_id, &ev.text, &ev.detail) {
                changed = true;
                if core.auto_approve_tools {
                    let _ = try core.resolve_tool_approval(allocator, thread_id, true);
                }
            }
        } else if ev.kind == provider::SessionEventKind::TurnCompleted {
            if try finish_turn_string(allocator, core, thread_id, &ev.text) {
                changed = true;
                completed = true;
            }
        } else if ev.kind == provider::SessionEventKind::TurnFailed {
            if try fail_turn_string(allocator, core, thread_id, &ev.detail) {
                changed = true;
            }
        }
        idx = idx + 1;
    }
    if completed {
        let t_idx = core.thread_index(thread_id);
        if t_idx >= 0 {
            var has_queue = false;
            if core.threads.at(t_idx) |thread| {
                has_queue = thread.machine_state == TurnMachineState::IdleQueued and
                    thread.queue.len() > 0;
            }
            if has_queue {
                let _ = try core.process_next_queued(allocator, thread_id);
            }
        }
    }
    return changed;
}

fn start_live_session_turn(
    allocator: Allocator,
    core: &var Core,
    thread_id: i64,
    kind: provider::ProviderKind,
    cwd: &string::String,
    model: &string::String,
    effort: provider::ReasoningEffort,
    resume_sid: &string::String,
    prompt: &string::String,
    attachments: &array::Array<string::String>
) -> mem::Error!bool {
    var s_idx = core.session_index(thread_id);
    if s_idx < 0 {
        let session = provider::new_provider_session(allocator, thread_id, kind);
        try core.sessions.append(allocator, move session);
        s_idx = core.sessions.len() - 1;
    }
    var events = array::new<provider::SessionEvent>(allocator);
    defer events.deinit(allocator);
    var started = false;
    let cwd_bytes = cwd.as_bytes();
    let model_bytes = model.as_bytes();
    let sid_bytes = resume_sid.as_bytes();
    let prompt_bytes = prompt.as_bytes();
    let socket_bytes = core.bridge_socket.as_bytes();
    let bin_bytes = core.bridge_bin.as_bytes();
    if core.sessions.at_mut(s_idx) |session| {
        started = try session.start_turn(
            allocator,
            kind,
            cwd_bytes,
            model_bytes,
            effort,
            sid_bytes,
            core.suppress_telemetry,
            socket_bytes,
            bin_bytes,
            &core.command_overrides,
            prompt_bytes,
            attachments,
            &var events
        );
    }
    let _ = try apply_session_events(allocator, core, thread_id, &events);
    return started;
}

pub fn (self: &var Core) process_next_queued(
    allocator: Allocator,
    thread_id: i64
) -> mem::Error!bool {
    let turn_id = try self.begin_next_queued_turn(allocator, thread_id);
    if turn_id < 0 {
        return false;
    }
    let index = self.thread_index(thread_id);
    if index < 0 {
        return false;
    }
    var kind = provider::ProviderKind::LocalEcho;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    var prompt_copy = string::new(allocator);
    defer prompt_copy.deinit(allocator);
    var cwd_copy = string::new(allocator);
    defer cwd_copy.deinit(allocator);
    var sid_copy = string::new(allocator);
    defer sid_copy.deinit(allocator);
    var attachments_copy = array::new<string::String>(allocator);
    defer attachments_copy.deinit(allocator);

    if self.threads.at(index) |thread| {
        kind = thread.provider;
        effort = thread.effort;
        try model_copy.append_string(allocator, &thread.model);
        try sid_copy.append_string(allocator, &thread.provider_session_id);
        if thread.workspace.mode == workspace::WorkspaceMode::GitWorktree and
            thread.workspace.worktree_path.len() > 0 {
            try cwd_copy.append_string(allocator, &thread.workspace.worktree_path);
        } else {
            try cwd_copy.append_string(allocator, &thread.workspace.root_path);
        }
        let msg_count = thread.messages.len();
        if msg_count > 0 {
            if thread.messages.at(msg_count - 1) |last| {
                try prompt_copy.append_string(allocator, &last.text);
                try replace_string_array(allocator, &var attachments_copy, &last.attachments);
            }
        }
    }

    if kind == provider::ProviderKind::LocalEcho {
        let output = try run_local_turn_strings(
            allocator,
            kind,
            &model_copy,
            effort,
            &prompt_copy,
            attachments_copy.len(),
            self.suppress_telemetry
        );
        defer output.deinit(allocator);

        var chunk_index = 0;
        while output.chunks.at(chunk_index) |chunk| {
            let _ = try append_delta_string(allocator, self, thread_id, chunk);
            chunk_index = chunk_index + 1;
        }
        return finish_turn_string(allocator, self, thread_id, &output.final_text);
    }

    let _ = try start_live_session_turn(
        allocator,
        self,
        thread_id,
        kind,
        &cwd_copy,
        &model_copy,
        effort,
        &sid_copy,
        &prompt_copy,
        &attachments_copy
    );
    return true;
}

fn steer_session_strings(
    allocator: Allocator,
    session: &var provider::ProviderSession,
    prompt: &string::String,
    attachments: &array::Array<string::String>,
    events: &var array::Array<provider::SessionEvent>
) -> mem::Error!bool {
    let prompt_bytes = prompt.as_bytes();
    return session.steer_prompt(allocator, prompt_bytes, attachments, events);
}

fn build_steered_user_message(
    allocator: Allocator,
    id: i64,
    turn_id: i64,
    text: &string::String,
    attachments: &array::Array<string::String>,
    provider_kind: provider::ProviderKind,
    model: &string::String
) -> mem::Error!Message {
    var msg_text = string::new(allocator);
    errdefer msg_text.deinit(allocator);
    try msg_text.append_string(allocator, text);
    var msg_attachments = try clone_string_array(allocator, attachments);
    errdefer msg_attachments.deinit(allocator);
    var msg_provider = try string::from_bytes(allocator, provider::provider_id(provider_kind));
    errdefer msg_provider.deinit(allocator);
    var msg_model = string::new(allocator);
    errdefer msg_model.deinit(allocator);
    try msg_model.append_string(allocator, model);
    return Message {
        id: id,
        turn_id: turn_id,
        role: MessageRole::User,
        text: move msg_text,
        attachments: move msg_attachments,
        provider: move msg_provider,
        model: move msg_model
    };
}

fn try_steer_active_turn(
    allocator: Allocator,
    core: &var Core,
    thread_id: i64,
    text: []u8,
    attachments_nl: []u8
) -> mem::Error!i64 {
    if is_blank(text) {
        return 0;
    }
    let t_idx = core.thread_index(thread_id);
    if t_idx < 0 {
        return 0;
    }
    var can_steer = false;
    if core.threads.at(t_idx) |thread| {
        if thread.provider == provider::ProviderKind::AntigravityAcp and
            (thread.machine_state == TurnMachineState::RunningEmpty or
            thread.machine_state == TurnMachineState::RunningQueued) {
            can_steer = true;
        }
    }
    if !can_steer {
        return 0;
    }
    let s_idx = core.session_index(thread_id);
    if s_idx < 0 {
        return 0;
    }
    var owned_text = try string::from_bytes(allocator, text);
    defer owned_text.deinit(allocator);
    string::trim_space_in_place(&var owned_text);
    if owned_text.len() == 0 {
        return 0;
    }
    var attachments = try parse_attachments(allocator, attachments_nl);
    defer attachments.deinit(allocator);

    var events = array::new<provider::SessionEvent>(allocator);
    defer events.deinit(allocator);
    var steered = false;
    if core.sessions.at_mut(s_idx) |session| {
        steered = try steer_session_strings(
            allocator,
            session,
            &owned_text,
            &attachments,
            &var events
        );
    }
    if !steered {
        let _ = try apply_session_events(allocator, core, thread_id, &events);
        return 0;
    }

    var project_id: i64 = 0;
    var active_turn_id: i64 = 0;
    var kind = provider::ProviderKind::AntigravityAcp;
    var effort = provider::ReasoningEffort::Medium;
    var model_copy = string::new(allocator);
    defer model_copy.deinit(allocator);
    var detail = string::new(allocator);
    defer detail.deinit(allocator);
    try join_attachments(allocator, &attachments, &var detail);
    var flushed_partial = string::new(allocator);
    defer flushed_partial.deinit(allocator);
    var empty_detail = string::new(allocator);
    defer empty_detail.deinit(allocator);

    if core.threads.at_mut(t_idx) |thread| {
        project_id = thread.project_id;
        active_turn_id = thread.active_turn_id;
        kind = thread.provider;
        effort = thread.effort;
        try model_copy.append_string(allocator, &thread.model);
        if thread.streaming_text.len() > 0 {
            try flushed_partial.append_string(allocator, &thread.streaming_text);
            let partial_msg_id = core.next_message_id;
            core.next_message_id = core.next_message_id + 1;
            let partial_msg = try build_assistant_message(
                allocator,
                partial_msg_id,
                active_turn_id,
                &flushed_partial,
                thread.provider,
                &thread.model
            );
            try thread.messages.append(allocator, move partial_msg);
            thread.streaming_text.clear();
        }
        let user_msg_id = core.next_message_id;
        core.next_message_id = core.next_message_id + 1;
        let user_msg = try build_steered_user_message(
            allocator,
            user_msg_id,
            active_turn_id,
            &owned_text,
            &attachments,
            thread.provider,
            &thread.model
        );
        try thread.messages.append(allocator, move user_msg);
        thread.updated_at_ms = store::unix_millis();
    } else {
        return 0;
    }

    if flushed_partial.len() > 0 {
        try record_event_strings(
            allocator,
            &var core.store,
            project_id,
            thread_id,
            active_turn_id,
            event::EventKind::MessageCompleted,
            kind,
            &model_copy,
            effort,
            &flushed_partial,
            &empty_detail
        );
    }
    try record_event_strings(
        allocator,
        &var core.store,
        project_id,
        thread_id,
        active_turn_id,
        event::EventKind::MessageUser,
        kind,
        &model_copy,
        effort,
        &owned_text,
        &detail
    );
    let _ = try apply_session_events(allocator, core, thread_id, &events);
    if active_turn_id > 0 {
        return active_turn_id;
    }
    return 1;
}

pub fn (self: &var Core) send_message(
    allocator: Allocator,
    thread_id: i64,
    text: []u8,
    attachments_nl: []u8
) -> mem::Error!i64 {
    let steered = try try_steer_active_turn(allocator, self, thread_id, text, attachments_nl);
    if steered > 0 {
        return steered;
    }
    let turn_id = try self.enqueue_turn(allocator, thread_id, text, attachments_nl);
    if turn_id < 0 {
        return -1;
    }
    let index = self.thread_index(thread_id);
    if index >= 0 {
        var busy = false;
        var is_local = false;
        if self.threads.at(index) |thread| {
            busy = thread_turn_is_running_or_waiting(thread.machine_state);
            is_local = thread.provider == provider::ProviderKind::LocalEcho;
        }
        if !busy {
            if is_local {
                while try self.process_next_queued(allocator, thread_id) {}
            } else {
                let _ = try self.process_next_queued(allocator, thread_id);
            }
        }
    }
    return turn_id;
}

pub fn (self: &var Core) poll_providers(allocator: Allocator) -> mem::Error!bool {
    var any_changed = false;
    var index: i64 = 0;
    while index < self.sessions.len() {
        var thread_id: i64 = 0;
        var events = array::new<provider::SessionEvent>(allocator);
        defer events.deinit(allocator);
        if self.sessions.at_mut(index) |session| {
            thread_id = session.thread_id;
            if try session.poll(allocator, &var events) {
                any_changed = true;
            }
        }
        if events.len() > 0 {
            if try apply_session_events(allocator, self, thread_id, &events) {
                any_changed = true;
            }
        }
        index = index + 1;
    }
    return any_changed;
}

pub fn (self: &Core) provider_wakeup_fds_json(
    allocator: Allocator,
    out: &var string::String
) -> mem::Error!void {
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encoder.begin_array();
    var idx: i64 = 0;
    while self.sessions.at(idx) |session| {
        let fd = session.wakeup_fd();
        if fd >= 0 {
            try encoder.begin_object();
            try encoder.write_i64_field("thread_id", session.thread_id);
            try encoder.write_i64_field("fd", cast<i64>(fd));
            try encoder.end_object();
        }
        idx = idx + 1;
    }
    try encoder.end_array();
    return encoder.finish_into(allocator, out);
}

fn write_string_array(encoder: &var json::Encoder, items: &array::Array<string::String>) -> mem::Error!void {
    var index = 0;
    while items.at(index) |item| {
        let bytes = item.as_bytes();
        try encoder.write_bytes(bytes);
        index = index + 1;
    }
    return;
}

fn (self: &Core) session_state_for_thread(thread_id: i64) -> []u8 {
    let idx = self.session_index(thread_id);
    if idx >= 0 {
        if self.sessions.at(idx) |session| {
            return provider::provider_session_state_name(session.state);
        }
    }
    return "disconnected";
}

fn write_thread_json(
    encoder: &var json::Encoder,
    core: &Core,
    thread: &Thread
) -> mem::Error!void {
    try encoder.begin_object();
    try encoder.write_i64_field("id", thread.id);
    try encoder.write_i64_field("project_id", thread.project_id);
    let title_bytes = thread.title.as_bytes();
    try encoder.write_bytes_field("title", title_bytes);
    try encoder.write_i64_field("updated_at_ms", thread.updated_at_ms);
    try encoder.write_bytes_field("status", thread_turn_status_name(thread.machine_state));
    try encoder.write_bytes_field("session_state", core.session_state_for_thread(thread.id));
    try encoder.write_bytes_field("provider", provider::provider_id(thread.provider));
    try encoder.write_bytes_field("provider_name", provider::provider_display_name(thread.provider));
    let model_bytes = thread.model.as_bytes();
    try encoder.write_bytes_field("model", model_bytes);
    try encoder.write_bytes_field("effort", provider::effort_id(thread.effort));
    try encoder.write_i64_field("active_turn_id", thread.active_turn_id);
    let stream_bytes = thread.streaming_text.as_bytes();
    try encoder.write_bytes_field("streaming_text", stream_bytes);
    let err_bytes = thread.last_error.as_bytes();
    try encoder.write_bytes_field("last_error", err_bytes);
    try encoder.begin_array_field("available_models");
    try write_string_array(encoder, &thread.available_models);
    try encoder.end_array();
    try encoder.begin_array_field("activities");
    var a_index = 0;
    while thread.activities.at(a_index) |act| {
        try encoder.begin_object();
        try encoder.write_i64_field("turn_id", act.turn_id);
        let cid_bytes = act.call_id.as_bytes();
        try encoder.write_bytes_field("call_id", cid_bytes);
        let ak_bytes = act.kind.as_bytes();
        try encoder.write_bytes_field("kind", ak_bytes);
        let at_bytes = act.title.as_bytes();
        try encoder.write_bytes_field("title", at_bytes);
        let as_bytes = act.status.as_bytes();
        try encoder.write_bytes_field("status", as_bytes);
        let ad_bytes = act.detail.as_bytes();
        try encoder.write_bytes_field("detail", ad_bytes);
        try encoder.end_object();
        a_index = a_index + 1;
    }
    try encoder.end_array();
    try encoder.begin_object_field("pending_approval");
    try encoder.write_bool_field("active", thread.pending_approval.active);
    let tool_bytes = thread.pending_approval.tool_name.as_bytes();
    try encoder.write_bytes_field("tool_name", tool_bytes);
    let summary_bytes = thread.pending_approval.summary.as_bytes();
    try encoder.write_bytes_field("summary", summary_bytes);
    try encoder.end_object();
    try encoder.begin_object_field("workspace");
    try workspace::write_workspace_json(encoder, &thread.workspace);
    try encoder.end_object();

    try encoder.begin_array_field("messages");
    var m_index = 0;
    while thread.messages.at(m_index) |message| {
        try encoder.begin_object();
        try encoder.write_i64_field("id", message.id);
        try encoder.write_i64_field("turn_id", message.turn_id);
        try encoder.write_bytes_field("role", role_name(message.role));
        let text_bytes = message.text.as_bytes();
        try encoder.write_bytes_field("text", text_bytes);
        let p_bytes = message.provider.as_bytes();
        try encoder.write_bytes_field("provider", p_bytes);
        let mod_bytes = message.model.as_bytes();
        try encoder.write_bytes_field("model", mod_bytes);
        try encoder.begin_array_field("attachments");
        try write_string_array(encoder, &message.attachments);
        try encoder.end_array();
        try encoder.end_object();
        m_index = m_index + 1;
    }
    try encoder.end_array();

    try encoder.begin_array_field("queue");
    var q_index = 0;
    while thread.queue.at(q_index) |queued| {
        try encoder.begin_object();
        try encoder.write_i64_field("turn_id", queued.turn_id);
        let q_bytes = queued.text.as_bytes();
        try encoder.write_bytes_field("text", q_bytes);
        try encoder.begin_array_field("attachments");
        try write_string_array(encoder, &queued.attachments);
        try encoder.end_array();
        try encoder.end_object();
        q_index = q_index + 1;
    }
    try encoder.end_array();
    return encoder.end_object();
}

pub fn (self: &Core) snapshot_json(allocator: Allocator, out: &var string::String) -> mem::Error!void {
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encoder.begin_object();
    try encoder.write_i64_field("schema_version", 1);
    try encoder.write_i64_field("active_project_id", self.active_project_id);
    try encoder.write_i64_field("active_thread_id", self.active_thread_id);
    try encoder.write_bool_field("suppress_telemetry", self.suppress_telemetry);
    try encoder.write_bool_field("auto_approve_tools", self.auto_approve_tools);
    try encoder.write_i64_field("event_count", self.store.count());

    try encoder.begin_array_field("providers");
    try provider::write_catalog_json(allocator, &var encoder, self.suppress_telemetry);
    try encoder.end_array();

    try encoder.begin_array_field("projects");
    var p_index = 0;
    while self.projects.at(p_index) |project| {
        try encoder.begin_object();
        try encoder.write_i64_field("id", project.id);
        let name_bytes = project.name.as_bytes();
        try encoder.write_bytes_field("name", name_bytes);
        let root_bytes = project.root_path.as_bytes();
        try encoder.write_bytes_field("root_path", root_bytes);
        try encoder.end_object();
        p_index = p_index + 1;
    }
    try encoder.end_array();

    try encoder.begin_array_field("threads");
    var t_index = 0;
    while self.threads.at(t_index) |thread| {
        try write_thread_json(&var encoder, self, thread);
        t_index = t_index + 1;
    }
    try encoder.end_array();

    try encoder.end_object();
    return encoder.finish_into(allocator, out);
}
