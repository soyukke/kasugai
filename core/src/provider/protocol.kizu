pub fn parse_claude_line(allocator: Allocator, line: []u8) -> mem::Error!WireSignal {
    var signal = new_wire_signal(allocator);
    errdefer signal.deinit(allocator);
    if json::decode_ignore_unknown<ClaudeHeader>(allocator, line) |header| {
        defer header.deinit(allocator);
        if header.session_id |sid| {
            try signal.session_id.append_string(allocator, sid);
        }
        if header.type |kind_str| {
            if string_equals(kind_str, "system") {
                if signal.session_id.len() > 0 {
                    signal.kind = WireSignalKind::SessionCreated;
                }
                return move signal;
            }
            if string_equals(kind_str, "stream_event") {
                if json::decode_ignore_unknown<ClaudeStreamEnvelope>(allocator, line) |env| {
                    defer env.deinit(allocator);
                    if env.event |ev| {
                        if ev.type |et| {
                            if string_equals(et, "content_block_delta") {
                                if ev.delta |delta| {
                                    if delta.text |txt| {
                                        try signal.text.append_string(allocator, txt);
                                        if signal.text.len() > 0 {
                                            signal.kind = WireSignalKind::Delta;
                                        }
                                    }
                                }
                            } else if string_equals(et, "content_block_start") {
                                if ev.content_block |blk| {
                                    if blk.type |bt| {
                                        if string_equals(bt, "tool_use") {
                                            signal.kind = WireSignalKind::Activity;
                                            try signal.activity_kind.append_bytes(allocator, "tool");
                                            try signal.activity_status.append_bytes(allocator, "running");
                                            if blk.id |cid| {
                                                try signal.call_id.append_string(allocator, cid);
                                            }
                                            if blk.name |nm| {
                                                try signal.text.append_string(allocator, nm);
                                            } else {
                                                try signal.text.append_bytes(allocator, "ツール実行");
                                            }
                                        } else if string_equals(bt, "thinking") {
                                            signal.kind = WireSignalKind::Activity;
                                            try signal.call_id.append_bytes(allocator, "thought");
                                            try signal.activity_kind.append_bytes(allocator, "thought");
                                            try signal.activity_status.append_bytes(allocator, "running");
                                            try signal.text.append_bytes(allocator, "思考中");
                                        }
                                    }
                                }
                            }
                        }
                    }
                } else |_| {}
                return move signal;
            }
            if string_equals(kind_str, "assistant") {
                if json::decode_ignore_unknown<ClaudeAssistantEnvelope>(allocator, line) |env| {
                    defer env.deinit(allocator);
                    var found_tool = false;
                    if env.message |msg| {
                        if msg.content |blocks| {
                            var idx: i64 = 0;
                            while blocks.at(idx) |blk| {
                                if blk.type |bt| {
                                    if string_equals(bt, "tool_use") {
                                        found_tool = true;
                                        signal.kind = WireSignalKind::Activity;
                                        signal.call_id.clear();
                                        signal.activity_kind.clear();
                                        signal.activity_status.clear();
                                        signal.text.clear();
                                        signal.detail.clear();
                                        try signal.activity_kind.append_bytes(allocator, "tool");
                                        try signal.activity_status.append_bytes(allocator, "running");
                                        if blk.id |cid| {
                                            try signal.call_id.append_string(allocator, cid);
                                        }
                                        if blk.name |nm| {
                                            try signal.text.append_string(allocator, nm);
                                        } else {
                                            try signal.text.append_bytes(allocator, "ツール実行");
                                        }
                                        if blk.input |inp| {
                                            if inp.command |cmd| {
                                                try signal.detail.append_string(allocator, cmd);
                                            } else if inp.file_path |fp| {
                                                try signal.detail.append_string(allocator, fp);
                                            } else if inp.description |desc| {
                                                try signal.detail.append_string(allocator, desc);
                                            }
                                        }
                                    }
                                }
                                if !found_tool {
                                    if blk.text |txt| {
                                        try signal.text.append_string(allocator, txt);
                                    }
                                }
                                idx = idx + 1;
                            }
                        }
                    }
                    if !found_tool and signal.text.len() > 0 {
                        signal.kind = WireSignalKind::AssistantFallback;
                    }
                } else |_| {}
                return move signal;
            }
            if string_equals(kind_str, "user") {
                if json::decode_ignore_unknown<ClaudeAssistantEnvelope>(allocator, line) |env| {
                    defer env.deinit(allocator);
                    if env.message |msg| {
                        if msg.content |blocks| {
                            var idx: i64 = 0;
                            while blocks.at(idx) |blk| {
                                if blk.type |bt| {
                                    if string_equals(bt, "tool_result") {
                                        signal.kind = WireSignalKind::Activity;
                                        signal.call_id.clear();
                                        signal.activity_kind.clear();
                                        signal.activity_status.clear();
                                        try signal.activity_kind.append_bytes(allocator, "tool");
                                        if blk.tool_use_id |cid| {
                                            try signal.call_id.append_string(allocator, cid);
                                        }
                                        let errored = blk.is_error orelse false;
                                        if errored {
                                            try signal.activity_status.append_bytes(allocator, "failed");
                                        } else {
                                            try signal.activity_status.append_bytes(allocator, "completed");
                                        }
                                        break;
                                    }
                                }
                                idx = idx + 1;
                            }
                        }
                    }
                } else |_| {}
                return move signal;
            }
            if string_equals(kind_str, "control_request") {
                if header.request_id |rid| {
                    try signal.str_req_id.append_string(allocator, rid);
                }
                if json::decode_ignore_unknown<ClaudeControlEnvelope>(allocator, line) |env| {
                    defer env.deinit(allocator);
                    if env.request |req| {
                        var is_tool = true;
                        if req.subtype |sub| {
                            if !string_equals(sub, "can_use_tool") {
                                is_tool = false;
                            }
                        }
                        if is_tool {
                            signal.kind = WireSignalKind::PermissionRequest;
                            if req.tool_name |tn| {
                                try signal.text.append_string(allocator, tn);
                            }
                            if req.input |inp| {
                                if inp.command |cmd| {
                                    try signal.detail.append_string(allocator, cmd);
                                } else if inp.file_path |fp| {
                                    try signal.detail.append_string(allocator, fp);
                                } else if inp.description |desc| {
                                    try signal.detail.append_string(allocator, desc);
                                }
                            }
                        }
                    }
                } else |_| {}
                if signal.kind == WireSignalKind::PermissionRequest {
                    if signal.text.len() == 0 {
                        try signal.text.append_bytes(allocator, "tool");
                    }
                    if signal.detail.len() == 0 {
                        try signal.detail.append_bytes(allocator, "ツール実行の承認が必要です");
                    }
                }
                return move signal;
            }
            if string_equals(kind_str, "result") {
                let is_err = header.is_error orelse false;
                if is_err {
                    signal.kind = WireSignalKind::TurnError;
                    if header.result |res| {
                        try signal.detail.append_string(allocator, res);
                    } else {
                        try signal.detail.append_bytes(allocator, "Claude Code ターンがエラー終了しました");
                    }
                } else {
                    signal.kind = WireSignalKind::TurnDone;
                    if header.result |res| {
                        try signal.text.append_string(allocator, res);
                    }
                }
                return move signal;
            }
        }
    } else |_| {}
    return move signal;
}

