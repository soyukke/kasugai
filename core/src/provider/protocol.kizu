    try enc.write_bytes_field("method", "session/new");
    try enc.begin_object_field("params");
    try enc.write_bytes_field("cwd", cwd);
    try enc.begin_array_field("mcpServers");
    try enc.end_array();
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

