import std::array;
import std::json;
import std::mem;
import std::string;

pub enum WireSignalKind {
    Ignore,
    InitializeResult,
    SessionCreated,
    ModelCatalog,
    Delta,
    AssistantFallback,
    Activity,
    PermissionRequest,
    UnknownRequest,
    TurnDone,
    TurnError,
}

pub struct WireSignal {
    pub kind: WireSignalKind,
    pub req_id: i64,
    pub str_req_id: string::String,
    pub session_id: string::String,
    pub call_id: string::String,
    pub activity_kind: string::String,
    pub activity_status: string::String,
    pub text: string::String,
    pub detail: string::String,
    pub allow_option_id: string::String,
    pub reject_option_id: string::String,
    pub model_option_id: string::String,
    pub effort_option_id: string::String,
    pub current_model: string::String,
    pub models: array::Array<string::String>,
}

pub fn new_wire_signal(allocator: Allocator) -> WireSignal {
    return WireSignal {
        kind: WireSignalKind::Ignore,
        req_id: 0,
        str_req_id: string::new(allocator),
        session_id: string::new(allocator),
        call_id: string::new(allocator),
        activity_kind: string::new(allocator),
        activity_status: string::new(allocator),
        text: string::new(allocator),
        detail: string::new(allocator),
        allow_option_id: string::new(allocator),
        reject_option_id: string::new(allocator),
        model_option_id: string::new(allocator),
        effort_option_id: string::new(allocator),
        current_model: string::new(allocator),
        models: array::new<string::String>(allocator)
    };
}

pub fn (self: WireSignal) deinit(allocator: Allocator) -> void {
    self.str_req_id.deinit(allocator);
    self.session_id.deinit(allocator);
    self.call_id.deinit(allocator);
    self.activity_kind.deinit(allocator);
    self.activity_status.deinit(allocator);
    self.text.deinit(allocator);
    self.detail.deinit(allocator);
    self.allow_option_id.deinit(allocator);
    self.reject_option_id.deinit(allocator);
    self.model_option_id.deinit(allocator);
    self.effort_option_id.deinit(allocator);
    self.current_model.deinit(allocator);
    self.models.deinit(allocator);
}

fn ascii_lower(byte: u8) -> u8 {
    if byte >= cast<u8>(65) and byte <= cast<u8>(90) {
        return cast<u8>(cast<i64>(byte) + 32);
    }
    return byte;
}

fn ends_with_ascii_ci(bytes: []u8, suffix: []u8) -> bool {
    let b_len = mem::len(bytes);
    let s_len = mem::len(suffix);
    if s_len > b_len {
        return false;
    }
    let start = b_len - s_len;
    var index: i64 = 0;
    while index < s_len {
        if ascii_lower(bytes[start + index]) != ascii_lower(suffix[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

pub fn is_image_path(path: []u8) -> bool {
    return ends_with_ascii_ci(path, ".png") or
        ends_with_ascii_ci(path, ".jpg") or
        ends_with_ascii_ci(path, ".jpeg") or
        ends_with_ascii_ci(path, ".gif") or
        ends_with_ascii_ci(path, ".webp");
}

fn append_prompt_with_attachments(
    allocator: Allocator,
    prompt: []u8,
    attachments: &array::Array<string::String>,
    skip_images: bool,
    out: &var string::String
) -> mem::Error!void {
    try out.append_bytes(allocator, prompt);
    var index: i64 = 0;
    var added = false;
    while attachments.at(index) |item| {
        let bytes = item.as_bytes();
        if mem::len(bytes) > 0 and (!skip_images or !is_image_path(bytes)) {
            if !added {
                try out.append_byte(allocator, 10);
                added = true;
            }
            try out.append_byte(allocator, 10);
            try out.append_bytes(allocator, "[Local attachment: ");
            try out.append_bytes(allocator, bytes);
            try out.append_bytes(allocator, "]");
        }
        index = index + 1;
    }
    return;
}

pub fn encode_acp_initialize(
    allocator: Allocator,
    req_id: i64,
    out: &var string::String
) -> mem::Error!void {
    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_bytes_field("jsonrpc", "2.0");
    try enc.write_i64_field("id", req_id);
    try enc.write_bytes_field("method", "initialize");
    try enc.begin_object_field("params");
    try enc.write_i64_field("protocolVersion", 1);
    try enc.begin_object_field("clientCapabilities");
    try enc.end_object();
    try enc.begin_object_field("clientInfo");
    try enc.write_bytes_field("name", "kasugai");
    try enc.write_bytes_field("version", "0.1.0");
    try enc.end_object();
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

