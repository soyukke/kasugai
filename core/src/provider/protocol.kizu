fn write_acp_prompt_text(
    enc: &var json::Encoder,
    text: &string::String
) -> mem::Error!void {
    let bytes = text.as_bytes();
    return enc.write_bytes_field("text", bytes);
}

pub fn encode_acp_prompt(
    allocator: Allocator,
    req_id: i64,
    session_id: []u8,
    prompt: []u8,
    attachments: &array::Array<string::String>,
    out: &var string::String
) -> mem::Error!void {
    var full = string::new(allocator);
    defer full.deinit(allocator);
    try append_prompt_with_attachments(allocator, prompt, attachments, false, &var full);

    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_bytes_field("jsonrpc", "2.0");
    try enc.write_i64_field("id", req_id);
    try enc.write_bytes_field("method", "session/prompt");
    try enc.begin_object_field("params");
    try enc.write_bytes_field("sessionId", session_id);
    try enc.begin_array_field("prompt");
    try enc.begin_object();
    try enc.write_bytes_field("type", "text");
    try write_acp_prompt_text(&var enc, &full);
    try enc.end_object();
    try enc.end_array();
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

pub fn encode_acp_permission_reply(
    allocator: Allocator,
    req_id: i64,
    option_id: []u8,
    out: &var string::String
) -> mem::Error!void {
    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_bytes_field("jsonrpc", "2.0");
    try enc.write_i64_field("id", req_id);
    try enc.begin_object_field("result");
    try enc.begin_object_field("outcome");
    if mem::len(option_id) > 0 {
        try enc.write_bytes_field("outcome", "selected");
        try enc.write_bytes_field("optionId", option_id);
    } else {
        try enc.write_bytes_field("outcome", "cancelled");
    }
    try enc.end_object();
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

