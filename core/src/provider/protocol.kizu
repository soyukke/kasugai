    }
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

pub fn encode_codex_turn_start(
    allocator: Allocator,
    req_id: i64,
    thread_id: []u8,
    prompt: []u8,
    attachments: &array::Array<string::String>,
    model: []u8,
    effort: ReasoningEffort,
    out: &var string::String
) -> mem::Error!void {
    var full = string::new(allocator);
    defer full.deinit(allocator);
    try append_prompt_with_attachments(allocator, prompt, attachments, true, &var full);

    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_i64_field("id", req_id);
    try enc.write_bytes_field("method", "turn/start");
    try enc.begin_object_field("params");
    try enc.write_bytes_field("threadId", thread_id);
    try enc.begin_array_field("input");
    try enc.begin_object();
    try enc.write_bytes_field("type", "text");
    try write_acp_prompt_text(&var enc, &full);
    try enc.begin_array_field("text_elements");
    try enc.end_array();
    try enc.end_object();
    var index: i64 = 0;
    while attachments.at(index) |item| {
        let bytes = item.as_bytes();
        if mem::len(bytes) > 0 and is_image_path(bytes) {
            try enc.begin_object();
            try enc.write_bytes_field("type", "localImage");
            try enc.write_bytes_field("path", bytes);
            try enc.end_object();
        }
        index = index + 1;
    }
    try enc.end_array();
    if mem::len(model) > 0 and !mem::equal_bytes(model, "default") {
        try enc.write_bytes_field("model", model);
    }
    try enc.write_bytes_field("effort", effort_id(effort));
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

pub fn encode_codex_approval_reply(
    allocator: Allocator,
    req_id: i64,
    approve: bool,
    out: &var string::String
) -> mem::Error!void {
    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_i64_field("id", req_id);
    try enc.begin_object_field("result");
    if approve {
        try enc.write_bytes_field("decision", "accept");
    } else {
        try enc.write_bytes_field("decision", "decline");
    }
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

