fn extract_rpc_request_id(
    allocator: Allocator,
    line: []u8,
    signal: &var WireSignal
) -> mem::Error!bool {
    if json::decode_ignore_unknown<RpcHeader>(allocator, line) |num_hdr| {
        defer num_hdr.deinit(allocator);
        if num_hdr.id |req_id| {
            signal.req_id = req_id;
            return true;
        }
    } else |_| {}
    if json::decode_ignore_unknown<RpcStrIdHeader>(allocator, line) |str_hdr| {
        defer str_hdr.deinit(allocator);
        if str_hdr.id |sid| {
            try signal.str_req_id.append_string(allocator, sid);
            return true;
        }
    } else |_| {}
    return false;
}

fn string_equals(value: &string::String, target: []u8) -> bool {
    let bytes = value.as_bytes();
    return mem::equal_bytes(bytes, target);
}

fn extract_rpc_error(allocator: Allocator, line: []u8, out: &var string::String) -> mem::Error!bool {
    if json::decode_ignore_unknown<RpcErrorEnvelope>(allocator, line) |env| {
        defer env.deinit(allocator);
        if env.error |err_obj| {
            if err_obj.message |msg| {
                try out.append_string(allocator, msg);
            } else {
                try out.append_bytes(allocator, "JSON-RPC error");
            }
            return true;
        }
    } else |_| {}
    return false;
}

fn push_unique_model(
    allocator: Allocator,
    models: &var array::Array<string::String>,
    candidate: &string::String
) -> mem::Error!void {
    let bytes = candidate.as_bytes();
    if mem::len(bytes) == 0 {
        return;
    }
    var index: i64 = 0;
    while models.at(index) |existing| {
        if string_equals(existing, bytes) {
            return;
        }
        index = index + 1;
    }
    var copy = try string::from_bytes(allocator, bytes);
    errdefer copy.deinit(allocator);
    return models.append(allocator, move copy);
}

fn collect_acp_config_options(
    allocator: Allocator,
    options: &array::Array<AcpConfigOption>,
    signal: &var WireSignal
) -> mem::Error!void {
    var index: i64 = 0;
    while options.at(index) |opt| {
        var is_model = false;
        var is_effort = false;
        if opt.category |cat| {
            if string_equals(cat, "model") {
                is_model = true;
            }
            if string_equals(cat, "thought_level") or string_equals(cat, "reasoning_effort") {
                is_effort = true;
            }
        }
        if opt.id |opt_id| {
            if string_equals(opt_id, "model") {
                is_model = true;
            }
            if string_equals(opt_id, "reasoning_effort") or string_equals(opt_id, "thought_level") or
                string_equals(opt_id, "variant") {
                is_effort = true;
            }
        }
        if is_model {
            if opt.id |opt_id| {
                signal.model_option_id.clear();
                try signal.model_option_id.append_string(allocator, opt_id);
            }
            if opt.currentValue |cur| {
                signal.current_model.clear();
                try signal.current_model.append_string(allocator, cur);
                try push_unique_model(allocator, &var signal.models, cur);
            }
            if opt.options |choices| {
                var c_idx: i64 = 0;
                while choices.at(c_idx) |choice| {
                    if choice.value |val| {
                        try push_unique_model(allocator, &var signal.models, val);
                    }
                    c_idx = c_idx + 1;
                }
            }
        }
        if is_effort {
            if opt.id |opt_id| {
                signal.effort_option_id.clear();
                try signal.effort_option_id.append_string(allocator, opt_id);
            }
        }
        index = index + 1;
    }
    return;
}

pub fn parse_acp_line(
    allocator: Allocator,
    line: []u8,
    init_req_id: i64,
    session_new_req_id: i64,
    prompt_req_id: i64
) -> mem::Error!WireSignal {
    var signal = new_wire_signal(allocator);
    errdefer signal.deinit(allocator);
    if json::decode_ignore_unknown<RpcMethodHeader>(allocator, line) |m_header| {
        defer m_header.deinit(allocator);
        if m_header.method |method| {
            if string_equals(method, "session/update") {
                if json::decode_ignore_unknown<AcpUpdateKindEnvelope>(allocator, line) |kind_env| {
                    defer kind_env.deinit(allocator);
                    var is_chunk = false;
                    var is_thought = false;
                    var is_tool = false;
                    if kind_env.params |params| {
                        if params.update |upd| {
                            if upd.sessionUpdate |su| {
                                if string_equals(su, "agent_message_chunk") {
                                    is_chunk = true;
                                } else if string_equals(su, "agent_thought_chunk") {
                                    is_thought = true;
                                } else if string_equals(su, "tool_call") or
                                    string_equals(su, "tool_call_update") {
                                    is_tool = true;
                                }
                            }
                        }
                    }
                    if is_chunk {
                        if json::decode_ignore_unknown<AcpChunkEnvelope>(allocator, line) |chunk_env| {
                            defer chunk_env.deinit(allocator);
                            if chunk_env.params |params| {
                                if params.update |upd| {
                                    if upd.content |content| {
                                        if content.text |txt| {
                                            try signal.text.append_string(allocator, txt);
                                        }
                                    } else if upd.text |txt| {
                                        try signal.text.append_string(allocator, txt);
                                    }
                                }
                            }
                            if signal.text.len() > 0 {
                                signal.kind = WireSignalKind::Delta;
                            }
                        } else |_| {}
                    } else if is_thought {
                        if json::decode_ignore_unknown<AcpChunkEnvelope>(allocator, line) |chunk_env| {
                            defer chunk_env.deinit(allocator);
                            if chunk_env.params |params| {
                                if params.update |upd| {
                                    if upd.content |content| {
                                        if content.text |txt| {
                                            try signal.detail.append_string(allocator, txt);
                                        }
                                    } else if upd.text |txt| {
                                        try signal.detail.append_string(allocator, txt);
                                    }
                                }
                            }
                            if signal.detail.len() > 0 {
                                signal.kind = WireSignalKind::Activity;
                                try signal.call_id.append_bytes(allocator, "thought");
                                try signal.activity_kind.append_bytes(allocator, "thought");
                                try signal.activity_status.append_bytes(allocator, "running");
                                try signal.text.append_bytes(allocator, "思考中");
                            }
                        } else |_| {}
                    } else if is_tool {
                        if json::decode_ignore_unknown<AcpToolUpdateEnvelope>(allocator, line) |tool_env| {
                            defer tool_env.deinit(allocator);
                            if tool_env.params |params| {
                                if params.update |upd| {
                                    signal.kind = WireSignalKind::Activity;
                                    try signal.activity_kind.append_bytes(allocator, "tool");
                                    if upd.toolCallId |cid| {
                                        try signal.call_id.append_string(allocator, cid);
                                    }
                                    if upd.title |title| {
                                        try signal.text.append_string(allocator, title);
                                    } else if upd.name |name| {
                                        try signal.text.append_string(allocator, name);
                                    } else if upd.kind |k| {
                                        try signal.text.append_string(allocator, k);
                                    } else {
                                        try signal.text.append_bytes(allocator, "ツール実行");
                                    }
                                    if upd.status |st| {
                                        if string_equals(st, "completed") or string_equals(st, "done") {
                                            try signal.activity_status.append_bytes(allocator, "completed");
                                        } else if string_equals(st, "failed") or string_equals(st, "error") {
                                            try signal.activity_status.append_bytes(allocator, "failed");
                                        } else {
                                            try signal.activity_status.append_bytes(allocator, "running");
                                        }
                                    } else {
                                        try signal.activity_status.append_bytes(allocator, "running");
                                    }
                                }
                            }
                        } else |_| {}
                    }
                } else |_| {}
                return move signal;
            }
            if string_equals(method, "session/request_permission") {
                signal.kind = WireSignalKind::PermissionRequest;
                let _ = try extract_rpc_request_id(allocator, line, &var signal);
                if json::decode_ignore_unknown<AcpPermissionEnvelope>(allocator, line) |perm_env| {
                    defer perm_env.deinit(allocator);
                    if perm_env.params |params| {
                        if params.toolCall |tc| {
                            if tc.name |n| {
                                try signal.text.append_string(allocator, n);
                            } else if tc.kind |k| {
                                try signal.text.append_string(allocator, k);
                            }
                            if tc.title |t| {
                                try signal.detail.append_string(allocator, t);
                            }
                        }
                        if params.options |opts| {
                            var o_idx: i64 = 0;
                            while opts.at(o_idx) |opt| {
                                if opt.optionId |oid| {
                                    if opt.kind |okind| {
                                        if (string_equals(okind, "allow_once") or string_equals(okind, "allow_always")) and
                                            signal.allow_option_id.len() == 0 {
                                            try signal.allow_option_id.append_string(allocator, oid);
                                        }
                                        if (string_equals(okind, "reject_once") or string_equals(okind, "reject_always")) and
                                            signal.reject_option_id.len() == 0 {
                                            try signal.reject_option_id.append_string(allocator, oid);
                                        }
                                    }
                                    if signal.allow_option_id.len() == 0 and o_idx == 0 {
                                        try signal.allow_option_id.append_string(allocator, oid);
                                    }
                                }
                                o_idx = o_idx + 1;
                            }
                        }
                    }
                } else |_| {}
                if signal.text.len() == 0 {
                    try signal.text.append_bytes(allocator, "tool");
                }
                if signal.detail.len() == 0 {
                    try signal.detail.append_bytes(allocator, "ツール実行の承認が必要です");
                }
                return move signal;
            }
            if try extract_rpc_request_id(allocator, line, &var signal) {
                signal.kind = WireSignalKind::UnknownRequest;
                try signal.text.append_string(allocator, method);
            }
            return move signal;
        }
    } else |_| {}
    if json::decode_ignore_unknown<RpcHeader>(allocator, line) |header| {
        defer header.deinit(allocator);
        let req_id = header.id orelse return move signal;
        signal.req_id = req_id;
        var err_msg = string::new(allocator);
        defer err_msg.deinit(allocator);
        if try extract_rpc_error(allocator, line, &var err_msg) {
            signal.kind = WireSignalKind::TurnError;
            try signal.detail.append_string(allocator, &err_msg);
            return move signal;
        }

        if req_id == init_req_id {
            signal.kind = WireSignalKind::InitializeResult;
            return move signal;
        }
        if req_id == session_new_req_id {
            if json::decode_ignore_unknown<AcpSessionNewEnvelope>(allocator, line) |env| {
                defer env.deinit(allocator);
                if env.result |res| {
                    if res.sessionId |sid| {
                        try signal.session_id.append_string(allocator, sid);
                    }
                    if res.configOptions |opts| {
                        try collect_acp_config_options(allocator, opts, &var signal);
                    }
                }
            } else |_| {}
            signal.kind = WireSignalKind::SessionCreated;
            return move signal;
        }
        if prompt_req_id > 0 and req_id == prompt_req_id {
            signal.kind = WireSignalKind::TurnDone;
            return move signal;
        }
    } else |_| {}
    return move signal;
}

