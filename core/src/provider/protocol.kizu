fn write_claude_content(enc: &var json::Encoder, content: &string::String) -> mem::Error!void {
    let bytes = content.as_bytes();
    return enc.write_bytes_field("content", bytes);
}

pub fn encode_claude_user_message(
    allocator: Allocator,
    prompt: []u8,
    attachments: &array::Array<string::String>,
    out: &var string::String
) -> mem::Error!void {
    var full = string::new(allocator);
    defer full.deinit(allocator);
    try append_prompt_with_attachments(allocator, prompt, attachments, false, &var full);

    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_bytes_field("type", "user");
    try enc.begin_object_field("message");
    try enc.write_bytes_field("role", "user");
    try write_claude_content(&var enc, &full);
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

pub fn encode_claude_control_response(
    allocator: Allocator,
    request_id: []u8,
    approve: bool,
    out: &var string::String
) -> mem::Error!void {
    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_bytes_field("type", "control_response");
    try enc.begin_object_field("response");
    try enc.write_bytes_field("subtype", "success");
    try enc.write_bytes_field("request_id", request_id);
    try enc.begin_object_field("response");
    if approve {
        try enc.write_bytes_field("behavior", "allow");
        try enc.begin_object_field("updatedInput");
        try enc.end_object();
    } else {
        try enc.write_bytes_field("behavior", "deny");
        try enc.write_bytes_field("message", "Denied by user");
    }
    try enc.end_object();
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

