}

pub fn encode_rpc_method_not_found(
    allocator: Allocator,
    req_id: i64,
    str_req_id: []u8,
    method: []u8,
    out: &var string::String
) -> mem::Error!void {
    var msg = try string::from_bytes(allocator, "Method not found: ");
    defer msg.deinit(allocator);
    if mem::len(method) > 0 {
        try msg.append_bytes(allocator, method);
    } else {
        try msg.append_bytes(allocator, "unknown");
    }
    let msg_bytes = msg.as_bytes();

    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_bytes_field("jsonrpc", "2.0");
    if mem::len(str_req_id) > 0 {
        try enc.write_bytes_field("id", str_req_id);
    } else {
        try enc.write_i64_field("id", req_id);
    }
    try enc.begin_object_field("error");
    try enc.write_i64_field("code", -32601);
    try enc.write_bytes_field("message", msg_bytes);
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

