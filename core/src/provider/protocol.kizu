pub fn encode_codex_thread_start(
    allocator: Allocator,
    req_id: i64,
    cwd: []u8,
    model: []u8,
    out: &var string::String
) -> mem::Error!void {
    var enc = json::encoder(allocator);
    defer enc.deinit(allocator);
    try enc.begin_object();
    try enc.write_i64_field("id", req_id);
    try enc.write_bytes_field("method", "thread/start");
    try enc.begin_object_field("params");
    try enc.write_bytes_field("cwd", cwd);
    try enc.write_bytes_field("approvalPolicy", "on-request");
    if mem::len(model) > 0 and !mem::equal_bytes(model, "default") {
        try enc.write_bytes_field("model", model);
    }
    try enc.end_object();
    try enc.end_object();
    return enc.finish_into(allocator, out);
}

