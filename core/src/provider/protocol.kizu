pub fn parse_codex_line(
    allocator: Allocator,
    line: []u8,
    init_req_id: i64,
    model_list_req_id: i64,
    thread_start_req_id: i64,
    turn_start_req_id: i64
) -> mem::Error!WireSignal {
    var signal = new_wire_signal(allocator);
    errdefer signal.deinit(allocator);
    if json::decode_ignore_unknown<RpcMethodHeader>(allocator, line) |m_header| {
        defer m_header.deinit(allocator);
        if m_header.method |method| {
            if string_equals(method, "item/agentMessage/delta") {
                if json::decode_ignore_unknown<CodexDeltaEnvelope>(allocator, line) |env| {
                    defer env.deinit(allocator);
                    if env.params |params| {
                        if params.delta |delta| {
                            try signal.text.append_string(allocator, delta);
                            if signal.text.len() > 0 {
                                signal.kind = WireSignalKind::Delta;
                            }
                        }
                    }
                } else |_| {}
                return move signal;
            }
            if string_equals(method, "item/started") or string_equals(method, "item/completed") {
                let is_completed = string_equals(method, "item/completed");
                if json::decode_ignore_unknown<CodexItemEventEnvelope>(allocator, line) |env| {
                    defer env.deinit(allocator);
                    if env.params |params| {
                        if params.item |item| {
                            if item.type |itype| {
                                if !string_equals(itype, "agentMessage") and
                                    !string_equals(itype, "userMessage") {
                                    signal.kind = WireSignalKind::Activity;
                                    if item.id |cid| {
                                        try signal.call_id.append_string(allocator, cid);
                                    }
                                    if string_equals(itype, "commandExecution") {
                                        try signal.activity_kind.append_bytes(allocator, "command");
                                        try signal.text.append_bytes(allocator, "コマンド実行");
                                    } else if string_equals(itype, "fileChange") {
                                        try signal.activity_kind.append_bytes(allocator, "tool");
                                        try signal.text.append_bytes(allocator, "ファイル変更");
                                    } else if string_equals(itype, "reasoning") {
                                        try signal.activity_kind.append_bytes(allocator, "thought");
                                        try signal.text.append_bytes(allocator, "思考中");
                                    } else {
                                        try signal.activity_kind.append_bytes(allocator, "tool");
                                        if item.tool |tname| {
                                            try signal.text.append_string(allocator, tname);
                                        } else {
                                            try signal.text.append_string(allocator, itype);
                                        }
                                    }
                                    if item.command |cmd| {
                                        try signal.detail.append_string(allocator, cmd);
                                    }
                                    if is_completed {
                                        if item.status |st| {
                                            if string_equals(st, "failed") or string_equals(st, "declined") {
                                                try signal.activity_status.append_bytes(allocator, "failed");
                                            } else {
                                                try signal.activity_status.append_bytes(allocator, "completed");
                                            }
                                        } else {
                                            try signal.activity_status.append_bytes(allocator, "completed");
                                        }
                                    } else {
                                        try signal.activity_status.append_bytes(allocator, "running");
                                    }
                                }
                            }
                        }
                    }
                } else |_| {}
                return move signal;
            }
            if string_equals(method, "turn/completed") {
                signal.kind = WireSignalKind::TurnDone;
                if json::decode_ignore_unknown<CodexTurnCompletedEnvelope>(allocator, line) |env| {
                    defer env.deinit(allocator);
                    if env.params |params| {
                        if params.turn |turn| {
                            if turn.status |st| {
                                if string_equals(st, "failed") or string_equals(st, "interrupted") {
                                    signal.kind = WireSignalKind::TurnError;
                                    if turn.error |err_obj| {
                                        if err_obj.message |msg| {
                                            try signal.detail.append_string(allocator, msg);
                                        }
                                    }
                                    if signal.detail.len() == 0 {
                                        try signal.detail.append_bytes(allocator, "Codex ターンが中断または失敗しました");
                                    }
                                }
                            }
                        }
                    }
                } else |_| {}
                return move signal;
            }
            if string_equals(method, "item/commandExecution/requestApproval") or
                string_equals(method, "item/fileChange/requestApproval") {
                signal.kind = WireSignalKind::PermissionRequest;
                let _ = try extract_rpc_request_id(allocator, line, &var signal);
                if string_equals(method, "item/fileChange/requestApproval") {
                    try signal.text.append_bytes(allocator, "file_change");
                } else {
                    try signal.text.append_bytes(allocator, "command");
                }
                if json::decode_ignore_unknown<CodexApprovalEnvelope>(allocator, line) |env| {
                    defer env.deinit(allocator);
                    if env.params |params| {
                        if params.command |cmd| {
                            try signal.detail.append_string(allocator, cmd);
                        } else if params.reason |reason| {
                            try signal.detail.append_string(allocator, reason);
                        }
                    }
                } else |_| {}
                if signal.detail.len() == 0 {
                    try signal.detail.append_bytes(allocator, "ツール実行の承認が必要です");
                }
                return move signal;
            }
            if try extract_rpc_request_id(allocator, line, &var signal) {
                signal.kind = WireSignalKind::UnknownRequest;
                try signal.text.append_string(allocator, method);
            }
            return move signal;
        }
    } else |_| {}
    if json::decode_ignore_unknown<RpcHeader>(allocator, line) |header| {
        defer header.deinit(allocator);
        let req_id = header.id orelse return move signal;
        signal.req_id = req_id;
        var err_msg = string::new(allocator);
        defer err_msg.deinit(allocator);
        if try extract_rpc_error(allocator, line, &var err_msg) {
            if req_id != model_list_req_id {
                signal.kind = WireSignalKind::TurnError;
                try signal.detail.append_string(allocator, &err_msg);
            }
            return move signal;
        }

        if req_id == init_req_id {
            signal.kind = WireSignalKind::InitializeResult;
            return move signal;
        }
        if req_id == model_list_req_id {
            if json::decode_ignore_unknown<CodexModelListEnvelope>(allocator, line) |env| {
                defer env.deinit(allocator);
                if env.result |res| {
                    if res.data |items| {
                        var idx: i64 = 0;
                        while items.at(idx) |item| {
                            if item.model |m| {
                                try push_unique_model(allocator, &var signal.models, m);
                            } else if item.id |mid| {
                                try push_unique_model(allocator, &var signal.models, mid);
                            }
                            idx = idx + 1;
                        }
                    }
                }
            } else |_| {}
            signal.kind = WireSignalKind::ModelCatalog;
            return move signal;
        }
        if req_id == thread_start_req_id {
            if json::decode_ignore_unknown<CodexThreadStartEnvelope>(allocator, line) |env| {
                defer env.deinit(allocator);
                if env.result |res| {
                    if res.thread |th| {
                        if th.id |tid| {
                            try signal.session_id.append_string(allocator, tid);
                        }
                    }
                }
            } else |_| {}
            signal.kind = WireSignalKind::SessionCreated;
            return move signal;
        }
    } else |_| {}
    let _ = turn_start_req_id;
    return move signal;
}
