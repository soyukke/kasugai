import std::json;
import std::mem;
import std::string;

pub error GhosttyError {
    Refused,
}

pub error TermFailure = GhosttyError or mem::Error;

extern "c" fn malloc(size: usize) -> ?ptr<u8>
extern "c" fn free(p: ptr<u8>) -> void
extern "c" struct TerminalOptions {
    cols: u16,
    rows: u16,
    max_scrollback: usize,
}

extern "c" struct GhosttyBuffer {
    data: ?ptr<u8>,
    cap: usize,
    len: usize,
}

extern "c" struct StyleColor {
    tag: i32,
    value: u64,
}

extern "c" struct GhosttyStyle {
    size: usize,
    fg_color: StyleColor,
    bg_color: StyleColor,
    underline_color: StyleColor,
    bold: bool,
    italic: bool,
    faint: bool,
    blink: bool,
    inverse: bool,
    invisible: bool,
    strikethrough: bool,
    overline: bool,
    underline: i32,
}

extern "c" struct TerminalScrollbar {
    total: u64,
    offset: u64,
    len: u64,
}

extern "c" struct Rgb {
    r: u8,
    g: u8,
    b: u8,
}

extern "c" struct ScrollValue {
    delta: isize,
    padding: u64,
}

extern "c" struct ScrollViewport {
    tag: i32,
    value: ScrollValue,
}

