#!/usr/bin/env python3
"""Render or check plain TLA+ machine modules from std::machine to_json() on stdin.

Usage:
  machine-tla [-check | --check] <module.tla>...
"""

import json
import os
import sys

def read_json_stream(raw):
    decoder = json.JSONDecoder()
    tables = []
    idx = 0
    total = len(raw)
    while idx < total:
        while idx < total and raw[idx].isspace():
            idx += 1
        if idx >= total:
            break
        obj, idx = decoder.raw_decode(raw, idx)
        tables.append(obj)
    return tables

def tla_str(val):
    return '"' + val.replace("\\", "\\\\").replace('"', '\\"') + '"'

def tla_set(items):
    return "{" + ", ".join(tla_str(x) for x in items) + "}"

def validate_table(name, table):
    states = table["states"]
    events = table["events"]
    outcomes = table["outcomes"]
    start = table["start"]
    moves = table["moves"]

    state_set = set(states)
    event_set = set(events)
    outcome_set = set(outcomes)

    if start not in state_set:
        raise ValueError(f"{name}: start state {start!r} is not listed in states")

    seen = set()
    for mv in moves:
        src = mv["from"]
        ev = mv["event"]
        out = mv["outcome"]
        dst = mv["to"]
        if src not in state_set or dst not in state_set:
            raise ValueError(f"{name}: move ({src}, {ev}) names an unlisted state")
        if ev not in event_set:
            raise ValueError(f"{name}: move ({src}, {ev}) names an unlisted event")
        if out not in outcome_set:
            raise ValueError(f"{name}: move ({src}, {ev}) names an unlisted outcome")
        pair = (src, ev)
        if pair in seen:
            raise ValueError(f"{name}: duplicate move for {src} and {ev}")
        seen.add(pair)

    for src in states:
        for ev in events:
            if (src, ev) not in seen:
                raise ValueError(f"{name}: missing move for {src} and {ev}")

def render_module(name, table):
    validate_table(name, table)
    states = table["states"]
    events = table["events"]
    outcomes = table["outcomes"]
    start = table["start"]
    moves = table["moves"]

    lines = [
        "\\* GENERATED by scripts/machine-tla. Do not edit.",
        f"---- MODULE {name} ----",
        f"States == {tla_set(states)}",
        f"Events == {tla_set(events)}",
        f"Outcomes == {tla_set(outcomes)}",
        f"Start == {tla_str(start)}",
        "",
        "Move(s, e) ==",
    ]
    for index, mv in enumerate(moves):
        prefix = "    CASE " if index == 0 else "      [] "
        lines.append(
            f"{prefix}s = {tla_str(mv['from'])} /\\ e = {tla_str(mv['event'])}"
            f" -> <<{tla_str(mv['to'])}, {tla_str(mv['outcome'])}>>"
        )
    lines.extend(
        [
            "",
            "VARIABLES state, previous, event, outcome, moved",
            "",
            "vars == <<state, previous, event, outcome, moved>>",
            "",
            "TypeOK ==",
            "    /\\ state \\in States",
            "    /\\ previous \\in States",
            "    /\\ event \\in Events",
            "    /\\ outcome \\in Outcomes",
            "    /\\ moved \\in BOOLEAN",
            "",
            "Init ==",
            "    /\\ state = Start",
            "    /\\ previous = Start",
            "    /\\ event \\in Events",
            "    /\\ outcome \\in Outcomes",
            "    /\\ moved = FALSE",
            "",
            "Take(e) ==",
            "    /\\ state' = Move(state, e)[1]",
            "    /\\ previous' = state",
            "    /\\ event' = e",
            "    /\\ outcome' = Move(state, e)[2]",
            "    /\\ moved' = TRUE",
            "",
            "Next == \\E e \\in Events : Take(e)",
            "",
            "Spec == Init /\\ [][Next]_vars",
            "====",
            "",
        ]
    )
    return "\n".join(lines)

def main():
    args = sys.argv[1:]
    check = False
    if args and args[0] in ("-check", "--check"):
        check = True
        args = args[1:]
    if not args:
        sys.stderr.write("usage: machine-tla [-check|--check] <module.tla>...\n")
        return 2

    tables = read_json_stream(sys.stdin.read())
    if len(tables) != len(args):
        sys.stderr.write(f"machine-tla: {len(args)} files for {len(tables)} tables\n")
        return 1

    stale = False
    for path, table in zip(args, tables):
        mod_name = os.path.splitext(os.path.basename(path))[0]
        try:
            rendered = render_module(mod_name, table)
        except ValueError as err:
            sys.stderr.write(f"machine-tla: {err}\n")
            return 1
        if check:
            if not os.path.isfile(path):
                sys.stderr.write(
                    f"machine-tla: {path} is missing; run `just spec-table`\n"
                )
                stale = True
                continue
            with open(path, "r", encoding="utf-8") as handle:
                existing = handle.read()
            if existing != rendered:
                sys.stderr.write(
                    f"machine-tla: {path} is out of step with the transition table; run `just spec-table`\n"
                )
                stale = True
        else:
            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
            with open(path, "w", encoding="utf-8") as handle:
                handle.write(rendered)

    return 1 if stale else 0

if __name__ == "__main__":
    sys.exit(main())
